NODE_ENV=production
PORT=3001
DATA_DIR=./data
HOST=127.0.0.1

# Set this on first install. The generated password is printed if omitted.
ADMIN_INITIAL_PASSWORD=replace-with-a-long-random-password

# Must include the /api suffix and use HTTPS in production.
MINIPROGRAM_API_BASE_URL=https://api.your-domain.example/api

# Secrets may be entered in the admin panel, or kept here for production.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_MCH_ID=
WECHAT_API_V3_KEY=
WECHAT_MERCHANT_SERIAL=
# Either paste the PEM contents with \n, or provide an absolute file path.
WECHAT_PRIVATE_KEY=
WECHAT_NOTIFY_URL=https://your-domain.example/api/payments/wechat/notify
WECHAT_PLATFORM_CERTIFICATE=
# Required for a PEM public key; X.509 certificates provide their own serial.
WECHAT_PLATFORM_SERIAL=
# Optional: defaults to the refund endpoint on the payment callback domain.
WECHAT_REFUND_NOTIFY_URL=
MEITUAN_CLIENT_ID=
MEITUAN_CLIENT_SECRET=
# Restaurant direct-connect, businessId 79. Bind vendorShopId and configure each
# fixed package as one whole-package ERP SKU in Meituan before real-voucher tests.
# The legacy client fields above cannot replace developerId / SignKey.
MEITUAN_DEVELOPER_ID=
MEITUAN_SIGN_KEY=
MEITUAN_VENDOR_SHOP_ID=
MEITUAN_ERP_ID=
MEITUAN_ERP_NAME=
MEITUAN_REDEMPTION_ENABLED=0
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=
DOUYIN_POI_ID=
DOUYIN_ACCOUNT_ID=
# Enable only after merchant authorization, customer self-use approval and a
# real-voucher integration test. Defaults to disabled, never simulates success.
DOUYIN_REDEMPTION_ENABLED=0

# Feie receipt printers. FP-V3-WH defaults to 58mm with no cutter.
# Register USER/UKEY in the selected region and bind the device SN/KEY.
FEIE_USER=
FEIE_UKEY=
FEIE_REGION=china
FEIE_PRINTING_ENABLED=0

# Upload storage. Leave STORAGE_PROVIDER empty to use local server storage by default
# and allow the super-admin panel to switch to S3-compatible object storage.
# Set STORAGE_PROVIDER=s3 to use Tencent COS, MinIO, AWS S3, or another
# S3-compatible service. Do not put a /api suffix in these storage URLs.
STORAGE_PROVIDER=
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_BASE_URL=
STORAGE_PATH_PREFIX=uploads/
