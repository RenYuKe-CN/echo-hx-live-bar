.page{padding:34rpx 28rpx 60rpx}.title{font-size:42rpx;font-weight:700;color:#193432}.muted{display:block;color:#82918c;font-size:23rpx;margin:12rpx 0 30rpx}.item{display:flex;align-items:center;gap:18rpx;padding:22rpx 0;border-bottom:1rpx solid #e2dfd7}.pic{width:88rpx;height:88rpx;border-radius:16rpx;background:#bd7c4e;color:#fff;display:grid;text-align:center;line-height:88rpx;font-size:38rpx;object-fit:cover}.info{flex:1;min-width:0}.info text{display:block;font-size:27rpx}.item>view:last-child text{display:block;text-align:right}.old{text-decoration:line-through;color:#9da4a4;font-size:21rpx}.price{color:#217c59;font-size:27rpx;font-weight:700}.summary{margin-top:40rpx;background:#fff;padding:22rpx;border-radius:18rpx}.summary view{display:flex;justify-content:space-between;padding:13rpx 0;color:#647174;font-size:25rpx}.summary .pay{border-top:1rpx solid #e7e8e8;margin-top:15rpx;color:#1d2e33;font-size:31rpx;font-weight:700;padding-top:25rpx}.green{color:#298962!important}.pay-button{margin-top:40rpx;background:#d59b64;color:#211b18;font-weight:700;height:88rpx;line-height:88rpx}.methods{margin-top:38rpx;border-top:1rpx solid #e7e8e8;padding-top:26rpx}.section-title{font-size:29rpx;font-weight:700;margin-bottom:12rpx}.method{display:flex;align-items:center;justify-content:space-between;gap:14rpx;padding:23rpx 18rpx;margin:12rpx 0;background:#fff;border:1rpx solid #e5e9e7;border-radius:16rpx;font-size:27rpx}.method.selected{border-color:#298962;background:#f0f8f3}.method .hint{display:block;color:#82908d;font-size:21rpx;margin-top:7rpx;line-height:1.5}.radio{color:#298962;font-size:34rpx}.warning{color:#b35b42;font-size:22rpx;padding:0 18rpx}.pay-button[disabled]{opacity:.55}.item-prices{max-width:240rpx}.item-prices .regular-price{color:#1d2e33}.item-prices .reference-price{color:#298962;font-size:21rpx;margin-top:6rpx}.upgrade-banner{font-size:24rpx;padding:24rpx 0;line-height:1.6;border-bottom:1rpx solid #e7e8e8}.upgrade-banner text{display:block;color:#298962}
