.page{padding:34rpx 28rpx 60rpx}.title{font-size:42rpx;font-weight:700;color:#193432}.muted{display:block;color:#82918c;font-size:23rpx;margin:12rpx 0 30rpx}.item{padding:22rpx 0;border-bottom:1rpx solid #e2dfd7}.item-main{display:flex;align-items:center;gap:18rpx}.pic{flex-shrink:0;width:88rpx;height:88rpx;border-radius:16rpx;background:#edf0e7;color:#647b68;display:block;text-align:center;line-height:88rpx;font-size:38rpx;overflow:hidden}.pic-image{object-fit:contain}.info{flex:1;min-width:0}.info text{display:block;font-size:27rpx;overflow-wrap:anywhere;line-height:1.5}.info .muted{font-size:23rpx;margin:8rpx 0 0}.gift-caption{color:#ba593e!important;font-size:21rpx!important;margin-top:8rpx}.item-prices text{display:block;text-align:right;overflow-wrap:anywhere}.old{text-decoration:line-through;color:#9da4a4;font-size:21rpx}.price{color:#217c59;font-size:27rpx;font-weight:700}.summary{margin-top:40rpx;background:#fff;padding:22rpx;border-radius:18rpx}.summary view{display:flex;justify-content:space-between;padding:13rpx 0;color:#647174;font-size:25rpx}.summary .pay{border-top:1rpx solid #e7e8e8;margin-top:15rpx;color:#1d2e33;font-size:31rpx;font-weight:700;padding-top:25rpx}.green{color:#298962!important}.pay-button{margin-top:40rpx;background:#d59b64;color:#211b18;font-weight:700;height:88rpx;line-height:88rpx}.methods{margin-top:38rpx;border-top:1rpx solid #e7e8e8;padding-top:26rpx}.section-title{font-size:29rpx;font-weight:700;margin-bottom:12rpx}.method{display:flex;align-items:center;justify-content:space-between;gap:14rpx;padding:23rpx 18rpx;margin:12rpx 0;background:#fff;border:1rpx solid #e5e9e7;border-radius:16rpx;font-size:27rpx}.method.selected{border-color:#298962;background:#f0f8f3}.method .hint{display:block;color:#82908d;font-size:21rpx;margin-top:7rpx;line-height:1.5}.radio{color:#298962;font-size:34rpx}.warning{color:#b35b42;font-size:22rpx;padding:0 18rpx}.pay-button[disabled]{opacity:.55}.item-prices{max-width:40%;flex-shrink:0}.item-prices .regular-price{color:#1d2e33}.item-prices .reference-price{color:#298962;font-size:21rpx;margin-top:6rpx}.gift-price{color:#ba593e!important;font-size:23rpx!important;font-weight:700}.cost-hint{color:#82908d!important;font-size:18rpx!important;margin-top:5rpx}.paid-price-block{margin-top:8rpx}.coupon-rule-banner{margin-top:24rpx;padding:18rpx 20rpx;background:#fff4e8;color:#a75a2a;border-radius:14rpx;font-size:22rpx;line-height:1.6}.upgrade-banner{font-size:24rpx;padding:24rpx 0;line-height:1.6;border-bottom:1rpx solid #e7e8e8}.upgrade-banner text{display:block;color:#298962}
.order-note{margin-top:28rpx;background:#fff;padding:22rpx;border-radius:18rpx}.order-note textarea{display:block;box-sizing:border-box;width:100%;min-height:100rpx;padding:18rpx;background:#f6f5f1;border-radius:12rpx;color:#253b38;font-size:25rpx;line-height:1.5}.coupon-select{margin-top:30rpx}.coupon-option{display:flex;justify-content:space-between;align-items:center;gap:14rpx;padding:21rpx 18rpx;margin:10rpx 0;background:#fff;border:1rpx solid #e5e9e7;border-radius:14rpx;font-size:25rpx}.coupon-option.selected{border-color:#298962;background:#f0f8f3}.coupon-option .hint{display:block;color:#82908d;font-size:20rpx;margin-top:6rpx}.coupon-amount{color:#ba593e;font-weight:700}

.item-actions{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-top:12rpx}.quantity-editor{display:flex;align-items:center;gap:6rpx}.quantity-label{font-size:22rpx;color:#697d74;min-width:3em;margin-right:8rpx}.quantity-value{min-width:48rpx;text-align:center;font-size:28rpx;font-weight:600;color:#193432}.quantity-editor button.quantity-button{display:flex;align-items:center;justify-content:center;flex:none;width:80rpx;min-width:44px;height:80rpx;min-height:44px;margin:0;padding:0;line-height:1;border-radius:14rpx;font-size:34rpx;box-sizing:border-box}.quantity-editor .minus{background:#e8eeea;color:#244c40}.quantity-editor .plus{background:#244c40;color:#fff}.quantity-editor button.quantity-button[disabled]{background:#e8ece8;color:#9aa99f}.item-actions button.item-remove{width:auto;min-width:44px;min-height:44px;display:flex;align-items:center;justify-content:center;margin:0;padding:0 10rpx;background:transparent;color:#7b6d60;font-size:23rpx;line-height:1.4}.item-actions button.item-remove[disabled]{color:#a5aba5}.quantity-hint{display:block;font-size:21rpx;color:#8a6e4c;line-height:1.5;text-align:right;margin:2rpx 0 6rpx}.cart-feedback,.cart-empty{margin:24rpx 0;padding:24rpx;background:#fff;border-radius:16rpx;color:#64746c;font-size:25rpx;line-height:1.6}.cart-feedback{color:#99583e}.cart-retry{margin-top:18rpx;padding:14rpx 22rpx;background:#e8eeea;color:#244c40;font-size:25rpx;line-height:1.5;min-height:44px}

.confirm-heading{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-bottom:12rpx}.confirm-heading .title{margin:0;flex:1;min-width:0}.confirm-table{max-width:45%;padding:12rpx 18rpx;border-radius:12rpx;background:#e6ece1;color:#234735;font-size:28rpx;line-height:1.4;font-weight:650;overflow-wrap:anywhere}.cart-hold{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-top:24rpx;padding:18rpx 22rpx;border-radius:16rpx;background:#edf3ed;color:#55715d;font-size:23rpx;line-height:1.5}.cart-hold text{flex:1;min-width:0}.cart-hold.expired{background:#fff0de;color:#965f32}.cart-hold button{flex:none;width:auto;min-height:44px;margin:0;padding:12rpx 16rpx;background:#193432;color:white;font-size:23rpx;line-height:1.5}
