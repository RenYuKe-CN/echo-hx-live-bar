.page{min-height:100vh;padding:28rpx;background:#f8f8f5;color:#304441}.current-card{padding:30rpx;background:#193432;color:#fff;border-radius:24rpx;box-shadow:0 12rpx 28rpx rgba(25,52,50,.16)}.current-heading{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.eyebrow{display:block;color:#b9c9c2;font-size:19rpx;letter-spacing:3rpx}.current-name{display:block;margin-top:8rpx;font-size:38rpx;font-weight:700}.current-badge{padding:8rpx 16rpx;border-radius:22rpx;color:#fff;font-size:22rpx}.ordinary-hint{display:block;margin-top:28rpx;color:#b9c9c2;font-size:23rpx}.progress-block{margin-top:30rpx}.progress-title,.progress-values,.tier-head,.tier-meta{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.progress-title{font-size:24rpx;color:#fff;margin-bottom:14rpx}.progress-title text:last-child{color:#f1c58f;font-weight:700}.progress-values{margin-top:14rpx;color:#b9c9c2;font-size:20rpx}.target-hint{display:block;margin-top:20rpx;color:#f1c58f;font-size:22rpx}.condition-list{display:grid;gap:7rpx;margin-top:10rpx;color:#d5e0da;font-size:21rpx}.section-title{display:flex;align-items:end;justify-content:space-between;margin:34rpx 4rpx 16rpx}.section-title text:first-child{font-size:30rpx;font-weight:700}.section-title text:last-child{font-size:20rpx;color:#8c9b95}.tier-card{padding:24rpx;background:#fff;border:1rpx solid #e8e3da;border-radius:18rpx;margin-bottom:14rpx;box-shadow:0 6rpx 18rpx rgba(39,53,48,.04)}.tier-title{display:flex;align-items:center;gap:10rpx;min-width:0;font-size:28rpx;font-weight:700}.tier-dot{width:18rpx;height:18rpx;border-radius:50%;flex:none}.current-label{font-size:19rpx;font-weight:400;color:#217c59;background:#e6f3eb;padding:5rpx 9rpx;border-radius:12rpx}.tier-discount{color:#ad673c;font-size:25rpx;font-weight:700}.tier-meta{margin-top:13rpx;color:#82918b;font-size:21rpx}.tier-condition{display:grid;gap:7rpx;margin-top:17rpx;padding-top:15rpx;border-top:1rpx solid #edf0eb;color:#536861;font-size:22rpx}.empty{text-align:center;color:#899793;padding:70rpx}
