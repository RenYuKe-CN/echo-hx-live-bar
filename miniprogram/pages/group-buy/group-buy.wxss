@import "../menu/menu-service.wxss";
.redeem-page{padding:28rpx 28rpx calc(40rpx + env(safe-area-inset-bottom))}.redeem-heading{display:flex;align-items:center;justify-content:space-between;margin-bottom:28rpx}.redeem-title{display:block;font-size:42rpx;font-weight:650}.redeem-heading image{width:68rpx;height:68rpx}.redeem-hint{display:block;font-size:25rpx;line-height:1.6;color:#718078;margin-top:10rpx;overflow-wrap:break-word}.redeem-panel{padding:28rpx;background:#fffefa;border:1rpx solid #e4e2db;border-radius:22rpx;margin-bottom:22rpx}.platform-tabs{display:flex;padding:6rpx;background:#efece5;border-radius:14rpx;gap:8rpx;margin-bottom:26rpx}.platform-tabs button{flex:1;padding:18rpx;background:transparent;color:#718078;font-size:28rpx;line-height:1.5;min-height:44px}.platform-tabs .active{background:#193432;color:#fff}.redeem-label{font-weight:600;font-size:28rpx}.code-field{display:flex;align-items:center;gap:12rpx;margin-top:16rpx;padding:12rpx 16rpx;border:1rpx solid #d4dbd3;border-radius:14rpx}.code-field input{flex:1;min-width:0;font-size:28rpx;min-height:44px}.code-field button{padding:14rpx;background:#e9eee6;color:#193432;font-size:25rpx;min-height:44px;line-height:1.5;flex:none}.redeem-primary{margin-top:24rpx;padding:20rpx;background:#193432;color:#fff;font-size:29rpx;font-weight:600;line-height:1.5;min-height:44px}.redeem-primary[disabled]{background:#dce2dc;color:#78867d}.redeem-help{background:transparent;color:#9b592f;font-size:26rpx;padding:18rpx 10rpx;line-height:1.5;min-height:44px}.redeem-status{padding:18rpx;background:#f0e9de;color:#9b592f;border-radius:12rpx;font-size:25rpx;line-height:1.5;margin-top:18rpx}.redeem-error{display:block;color:#a44d36;font-size:26rpx;line-height:1.6;margin-top:16rpx}.redeem-card-heading{display:flex;justify-content:space-between;gap:16rpx;font-size:31rpx;font-weight:600;line-height:1.5}.redeem-card-heading>text:first-child{flex:1;min-width:0;overflow-wrap:break-word}.redeem-price{color:#b66d3f;flex:none}.redeem-part{display:flex;justify-content:space-between;gap:20rpx;margin-top:18rpx;font-size:27rpx;line-height:1.5}.redeem-part>text:first-child{flex:1;min-width:0}.redeem-history-heading{display:flex;align-items:center;justify-content:space-between;font-size:30rpx;font-weight:600}.redeem-history-heading button{background:transparent;color:#193432;padding:18rpx;font-size:26rpx;min-height:44px;line-height:1.5}.redeem-history{display:flex;justify-content:space-between;gap:20rpx;padding:22rpx 0;border-bottom:1rpx solid #e4e2db}.redeem-history>view{flex:1;min-width:0}.redeem-history-name{font-size:29rpx;font-weight:600;overflow-wrap:break-word}.redeem-history-state{max-width:200rpx;color:#9b592f;font-size:25rpx;line-height:1.6;text-align:right}
