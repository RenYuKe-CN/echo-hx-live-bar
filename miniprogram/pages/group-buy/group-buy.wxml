<view class="redeem-page">
  <view class="redeem-heading"><view><text class="redeem-title">团购兑换</text><text class="redeem-hint">兑换后送至 {{tableNo ? tableNo + ' 桌' : '扫码桌台'}}</text></view><image src="/assets/icons/ticket-green.png" mode="aspectFit"/></view>
  <view class="redeem-panel">
    <view class="platform-tabs"><button class="{{platform === 'meituan' ? 'active' : ''}}" data-platform="meituan" bindtap="choosePlatform" disabled="{{busy}}">美团</button><button class="{{platform === 'douyin' ? 'active' : ''}}" data-platform="douyin" bindtap="choosePlatform" disabled="{{busy}}">抖音</button></view>
    <text class="redeem-label">券码</text><view class="code-field"><input value="{{code}}" bindinput="onCode" disabled="{{busy}}" maxlength="256" placeholder="粘贴券详情中的核销码" aria-label="团购核销码"/><button bindtap="paste" disabled="{{busy}}">粘贴</button></view>
    <text class="redeem-hint">打开平台订单的券详情，复制核销码；订单号不能用于兑换。</text>
    <view wx:if="{{platforms[platform] && !platforms[platform].ready}}" class="redeem-status">{{platforms[platform].message}}</view>
    <button class="redeem-primary" bindtap="query" loading="{{busy}}" disabled="{{busy || !connected || !code || !platforms[platform].ready}}">查询套餐</button>
    <text wx:if="{{error}}" class="redeem-error">{{error}}</text>
    <button class="redeem-help" bindtap="openService" disabled="{{!connected}}">联系服务员协助兑换</button>
  </view>
  <view wx:for="{{preview}}" wx:key="id" class="redeem-panel">
    <view class="redeem-card-heading"><text>{{item.name}}</text><text class="redeem-price">¥{{item.amountText}}</text></view>
    <view wx:for="{{item.components}}" wx:for-item="part" wx:key="name" class="redeem-part"><text>{{part.name}}</text><text>× {{part.quantity}} {{part.unit}}</text></view>
    <text class="redeem-hint">{{item.platformName}} · {{item.voucher}} · {{item.statusLabel}}</text>
    <text wx:if="{{item.rulesText}}" class="redeem-hint">{{item.rulesText}}</text>
    <block wx:if="{{item.state === 'prepared'}}"><text class="redeem-hint">确认后核销此券，套餐送至 {{tableNo}} 桌。</text><button class="redeem-primary" data-id="{{item.id}}" bindtap="consume" loading="{{busy}}" disabled="{{busy}}">确认兑换并配送</button></block>
    <button wx:if="{{item.orderNo}}" class="redeem-help" data-order="{{item.orderNo}}" bindtap="openOrder">查看配送订单</button>
    <text wx:if="{{item.error}}" class="redeem-error">{{item.error}}</text>
  </view>
  <view class="redeem-history-heading"><text>我的兑换记录</text><button bindtap="load">刷新</button></view>
  <text wx:if="{{loading}}" class="redeem-hint">正在加载...</text><text wx:elif="{{!records.length}}" class="redeem-hint">还没有兑换记录</text>
  <view wx:for="{{records}}" wx:key="id" class="redeem-history" data-order="{{item.orderNo}}" bindtap="openOrder"><view><text class="redeem-history-name">{{item.name}}</text><text class="redeem-hint">{{item.platformName}} · {{item.voucher}}</text><text class="redeem-hint">{{item.createdAt}}</text></view><text class="redeem-history-state">{{item.statusLabel}}</text></view>
</view>
<include src="../menu/menu-service.wxml"/>
