.page{padding:34rpx 28rpx 50rpx}.heading{display:flex;justify-content:space-between;align-items:center;margin-bottom:24rpx;font-size:38rpx;font-weight:700;color:#193432}.heading text:last-child{font-size:24rpx;color:#217c59;background:#e6f3eb;padding:10rpx 14rpx;border-radius:12rpx}.reward{display:flex;align-items:center;background:#fff;padding:20rpx;margin-bottom:14rpx;border:1rpx solid #e8e3da;border-radius:20rpx;gap:18rpx;box-shadow:0 6rpx 18rpx rgba(39,53,48,.05)}.reward image,.placeholder{width:120rpx;height:120rpx;border-radius:14rpx;flex:none}.placeholder{display:flex;align-items:center;justify-content:center;background:#e3f1e9;color:#217c59;font-size:34rpx;font-weight:700}.details{flex:1;display:flex;flex-direction:column;gap:7rpx;min-width:0}.name{font-size:28rpx;font-weight:700;color:#304441}.points{color:#217c59;font-weight:700}.muted{color:#899793;font-size:22rpx}.reward button{background:#193432;color:#fff;margin:0;padding:0 20rpx;line-height:64rpx;height:64rpx;font-size:23rpx}.reward button[disabled]{background:#d1d7d6;color:#78837f}.empty{text-align:center;color:#899793;padding:70rpx}.history{margin-top:35rpx}.section-title{font-weight:700;font-size:30rpx;color:#304441}.history-row{display:flex;justify-content:space-between;gap:20rpx;padding:22rpx 0;border-bottom:1rpx solid #ddd;font-size:23rpx}.history-row text:last-child{color:#899793;text-align:right}
