<view class="page"><view class="heading"><text>兑换中心</text><text>可用积分 {{points}}</text></view><view wx:for="{{rewards}}" wx:key="id" class="reward"><image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill"/><view wx:else class="placeholder">礼</view><view class="details"><text class="name">{{item.name}}</text><text class="points">{{item.points}} 积分</text><text class="muted">剩余 {{item.stock}} 件</text></view><button size="mini" disabled="{{busy || item.stock < 1 || points < item.points}}" data-id="{{item.id}}" bindtap="redeem">兑换</button></view><view wx:if="{{!rewards.length}}" class="empty">暂无可兑换奖品</view><view class="history" wx:if="{{redemptions.length}}"><text class="section-title">兑换记录</text><view wx:for="{{redemptions}}" wx:for-item="record" wx:key="id" class="history-row"><text>{{record.reward_name}}</text><text>-{{record.points}} 积分 · {{record.statusLabel}}</text></view></view></view>
