<view class="page"><view class="tabs"><view wx:for="{{tabs}}" wx:key="*this" class="tab {{tab === index ? 'active' : ''}}" data-index="{{index}}" bindtap="chooseTab">{{item}}</view></view><view wx:for="{{visible}}" wx:key="id" class="coupon"><view class="face"><image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill"/><text wx:else>券</text></view><view class="details"><text class="name">{{item.name}}</text><text>{{item.minimumText}} · {{item.description || '到店点单可用'}}</text><text>有效期至 {{item.expiryText}}</text></view><text class="amount">{{item.amountText}}</text></view><view wx:if="{{!visible.length}}" class="empty">暂无相关优惠券</view><view class="hint">使用优惠券按商品原价计算，不叠加会员价，也不能使用赠金；可使用储值本金。</view></view>
