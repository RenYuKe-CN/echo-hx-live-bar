.page{padding:26rpx;background:#f5f6f3;min-height:100vh;box-sizing:border-box}.tabs{display:flex;background:#fff;border-radius:8rpx;margin-bottom:22rpx}.tab{flex:1;text-align:center;padding:22rpx 0;color:#697b76;font-size:27rpx}.tab.active{color:#287755;border-bottom:4rpx solid #287755;font-weight:700}.coupon{display:flex;align-items:center;gap:18rpx;padding:26rpx 20rpx;background:#fff;margin-bottom:14rpx;border-radius:8rpx}.face{width:76rpx;height:76rpx;flex:none;background:#dfeee7;color:#277955;display:flex;justify-content:center;align-items:center;border-radius:8rpx;font-size:35rpx;overflow:hidden}.face image{width:100%;height:100%}.details{flex:1;min-width:0;display:flex;flex-direction:column;gap:8rpx;color:#788682;font-size:21rpx}.details .name{color:#263f39;font-size:29rpx;font-weight:700}.gift-name{color:#ba593e}.gift-price{color:#287755;font-size:21rpx}.coupon-action{display:flex;align-items:flex-end;flex-direction:column;gap:10rpx;flex:none}.amount{color:#ba593e;font-size:31rpx;font-weight:700}.use-button{margin:0;padding:0 18rpx;height:52rpx;line-height:52rpx;border-radius:26rpx;background:#287755;color:#fff;font-size:22rpx}.disabled-button{background:#c1c9c5;color:#fff}.empty{text-align:center;color:#83918b;padding:110rpx 0}.hint{font-size:22rpx;color:#71807b;line-height:1.7;margin-top:20rpx}
