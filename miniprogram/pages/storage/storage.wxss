.page{padding:34rpx 28rpx 50rpx}.title{font-size:42rpx;font-weight:700;color:#193432}.muted{display:block;color:#82918c;font-size:23rpx;margin:12rpx 0 30rpx}.record{background:#fff;border:1rpx solid #e8e3da;border-radius:20rpx;padding:26rpx 24rpx;margin-bottom:18rpx;display:flex;justify-content:space-between;align-items:flex-start;gap:20rpx;box-shadow:0 6rpx 18rpx rgba(39,53,48,.05)}.record>view{min-width:0}.record>view>text{display:block;font-size:27rpx;line-height:1.7}.record>view>text:first-child{font-weight:700;color:#304441}.record .muted{margin:2rpx 0 0;font-size:22rpx}.status{color:#217c59;background:#e6f3eb;padding:8rpx 12rpx;border-radius:10rpx;font-size:22rpx;white-space:nowrap}.empty{padding:100rpx 30rpx;text-align:center;color:#82918c}
