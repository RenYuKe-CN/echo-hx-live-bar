<view class="page"><view class="title">我的存酒</view><text class="muted">服务员登记的批量存酒会显示在这里</text><view wx:for="{{records}}" wx:key="id" class="record"><view><text>{{item.product_name}}</text><text class="muted">剩余 {{item.quantity}} 件 · {{item.expired ? '已过期' : '剩余 ' + item.remainingDays + ' 天'}}</text><text class="muted">到期日期 {{item.expiresDate}}</text></view><text class="status">{{item.statusLabel}}</text></view><view wx:if="{{!records.length}}" class="empty">暂无存酒记录</view></view>
