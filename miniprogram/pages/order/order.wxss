.page{padding:34rpx 28rpx 50rpx}.title{font-size:42rpx;font-weight:700;color:#193432}.muted{display:block;color:#82918c;font-size:23rpx;margin:12rpx 0 30rpx}.order{background:#fff;border:1rpx solid #e8e3da;border-radius:20rpx;padding:24rpx;margin-bottom:18rpx;display:flex;justify-content:space-between;gap:20rpx;box-shadow:0 6rpx 18rpx rgba(39,53,48,.05)}.order>view{min-width:0}.order>view>text{display:block;font-size:25rpx;line-height:1.65}.order>view>text:first-child{font-weight:700;color:#304441;font-size:27rpx}.amount{color:#217c59;font-size:30rpx;font-weight:700;white-space:nowrap}.empty{padding:100rpx 30rpx;text-align:center;color:#82918c}
.order-note{display:block;margin:8rpx 0;color:#875b38;font-size:23rpx;line-height:1.5;white-space:pre-wrap}
