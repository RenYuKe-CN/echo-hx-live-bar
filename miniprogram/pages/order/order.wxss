.page{padding:34rpx 28rpx 50rpx}.title{font-size:42rpx;font-weight:700;color:#193432}.muted{display:block;color:#82918c;font-size:23rpx;margin:12rpx 0 20rpx}.order{background:#fff;border:1rpx solid #e8e3da;border-radius:20rpx;padding:24rpx;margin-bottom:18rpx;display:flex;justify-content:space-between;gap:20rpx;box-shadow:0 6rpx 18rpx rgba(39,53,48,.05)}.order-main{min-width:0;flex:1}.order-heading{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.order-no{font-weight:700;color:#304441;font-size:27rpx}.status{font-size:22rpx;padding:5rpx 12rpx;border-radius:999rpx;white-space:nowrap}.status-pending{color:#9a641c;background:#fff3d9}.status-paid{color:#217c59;background:#e5f5ed}.status-closed{color:#82918c;background:#eef1ef}.order-main>text{display:block;font-size:25rpx;line-height:1.55}.order-actions{display:flex;align-items:center;flex-wrap:wrap;gap:12rpx;margin-top:18rpx}.expire-text{color:#bd6c1f!important;font-size:22rpx;line-height:1.4;flex:1 1 100%;min-width:0}.order-actions button{margin:0;height:68rpx;line-height:68rpx;border-radius:12rpx;font-size:25rpx;flex:none;padding:0 22rpx}.pay-button{color:#fff;background:#217c59}.cancel-button{color:#687773;background:#f2f4f1}.empty{padding:100rpx 30rpx;text-align:center;color:#82918c}
.order-note{display:block;margin:8rpx 0;color:#875b38;font-size:23rpx;line-height:1.5;white-space:pre-wrap}.hide-button{color:#8a6255;background:#faf4f0}.order-actions .hide-button{padding:0 16rpx}
