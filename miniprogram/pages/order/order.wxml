<view class="page"><view class="title">桌台订单</view><view wx:for="{{orders}}" wx:key="id" class="order"><view class="order-main"><view class="order-heading"><text class="order-no">{{item.order_no}}</text><text class="status {{item.payment_status === 'pending' ? 'status-pending' : item.payment_status === 'paid' ? 'status-paid' : 'status-closed'}}">{{item.fulfillmentLabel}}</text></view><text class="muted">{{item.created_at}} · {{item.paymentMethodLabel}}</text><text class="muted">原价 ¥{{item.originalText}} · 优惠 ¥{{item.discountText}}</text><text wx:if="{{item.note}}" class="order-note">备注：{{item.note}}</text><text wx:if="{{item.payment_method === 'balance' || item.payment_method === 'mixed'}}" class="muted">储值 ¥{{item.storedText}} · 赠金 ¥{{item.bonusText}}<text wx:if="{{item.payment_method === 'mixed'}}"> · 微信 ¥{{item.wechatText}}</text></text><text wx:if="{{item.payment_method === 'wechat'}}" class="muted">微信待支付 ¥{{item.wechatText}}</text><view wx:if="{{item.canPay || item.canCancel}}" class="order-actions"><text wx:if="{{item.expireText}}" class="expire-text">{{item.expireText}}</text><button wx:if="{{item.canPay}}" class="pay-button" data-order-no="{{item.order_no}}" bindtap="continuePay" loading="{{busyOrderNo === item.order_no}}">继续支付</button><button wx:if="{{item.canCancel}}" class="cancel-button" data-order-no="{{item.order_no}}" bindtap="cancelOrder" loading="{{busyOrderNo === item.order_no}}">取消订单</button></view></view><text class="amount">实付 ¥{{item.payableText}}</text></view><view wx:if="{{!orders.length}}" class="empty">暂时还没有订单</view></view>
