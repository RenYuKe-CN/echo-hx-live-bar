<view class="page"><view class="title">桌台订单</view><view wx:for="{{orders}}" wx:key="id" class="order"><view><text>{{item.order_no}}</text><text class="muted">{{item.created_at}} · {{item.fulfillmentLabel}} · {{item.paymentMethodLabel}}</text><text class="muted">原价 ¥{{item.originalText}} · 优惠 ¥{{item.discountText}}</text><text wx:if="{{item.note}}" class="order-note">备注：{{item.note}}</text><text wx:if="{{item.payment_method === 'balance' || item.payment_method === 'mixed'}}" class="muted">储值 ¥{{item.storedText}} · 赠金 ¥{{item.bonusText}}<text wx:if="{{item.payment_method === 'mixed'}}"> · 微信 ¥{{item.wechatText}}</text></text><text wx:if="{{item.payment_method === 'wechat'}}" class="muted">微信待支付 ¥{{item.wechatText}}</text></view><text class="amount">实付 ¥{{item.payableText}}</text></view><view wx:if="{{!orders.length}}" class="empty">暂时还没有订单</view></view>
