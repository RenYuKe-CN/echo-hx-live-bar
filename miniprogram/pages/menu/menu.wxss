@import "menu-service.wxss";
@import "menu-overlays.wxss";
.menu-page{height:100vh;display:flex;flex-direction:column;padding:20rpx 0 0;box-sizing:border-box;overflow:hidden}
.menu-heading{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin:0 24rpx 18rpx;flex:none}
.heading-copy{flex:1;min-width:0}.heading-title{display:block;font-size:42rpx;font-weight:700;line-height:1.35;overflow-wrap:break-word}.heading-hint{display:block;margin-top:8rpx;color:#69776f;font-size:26rpx;line-height:1.5}
.table-chip{display:flex;align-items:center;gap:8rpx;flex:none;max-width:240rpx;padding:12rpx 18rpx;border:1rpx solid #c77f52;border-radius:40rpx;color:#9b592f;font-size:24rpx;line-height:1.5;box-sizing:border-box}.table-chip image{width:30rpx;height:30rpx;flex:none}.table-chip text{overflow-wrap:break-word}
.membership-strip{display:flex;align-items:center;justify-content:space-between;gap:20rpx;width:100%;margin:0 0 22rpx;padding:14rpx 18rpx;background:#f0e9de;border-radius:16rpx;font-size:26rpx;line-height:1.5;text-align:left}
.member-label,.member-link{display:flex;align-items:center;gap:12rpx}.member-label{min-width:0;color:#a15d33;font-weight:600}.member-label text{overflow-wrap:break-word}.member-mark{display:flex;align-items:center;justify-content:center;width:44rpx;height:44rpx;background:#9b592f;border-radius:50%;flex:none}.member-mark image{width:30rpx;height:30rpx}.member-link{flex:none;color:#69776f;font-size:24rpx;font-weight:400}.chevron{font-size:36rpx;line-height:1}
.menu-tools{display:flex;align-items:stretch;gap:14rpx;padding:0 24rpx 16rpx;flex:none}.menu-tools .membership-strip{flex:1;min-width:0;width:auto;margin:0;font-size:24rpx}.group-buy-entry{display:flex;align-items:center;justify-content:center;gap:8rpx;padding:12rpx 16rpx;background:#e9eee6;color:#193432;border-radius:16rpx;font-size:24rpx;min-height:44px;flex:none}.group-buy-entry image{width:30rpx;height:30rpx}
.catalog-body{display:flex;flex:1;min-height:0;overflow:hidden;background:#fffefa}.category-sidebar{height:100%;width:154rpx;flex:none;background:#efece5}.category-tab{display:flex;align-items:center;justify-content:center;position:relative;width:100%;min-height:106rpx;min-height:52px;margin:0;padding:20rpx 12rpx;background:transparent;color:#66746b;border-radius:0;font-size:26rpx;line-height:1.5;white-space:normal;overflow-wrap:break-word}.category-tab.is-active{background:#fffefa;color:#193432;font-weight:650}.category-tab.is-active::before{content:"";position:absolute;left:0;top:30%;bottom:30%;width:6rpx;border-radius:0 6rpx 6rpx 0;background:#b66d3f}.product-scroll{height:100%;flex:1;width:0;min-width:0}.product-list,.menu-loading{padding:0 20rpx}.catalog-section-title{padding:22rpx 0 8rpx;color:#193432;font-size:28rpx;font-weight:650}.product-composition{display:block;margin-top:8rpx;color:#69776f;font-size:22rpx;line-height:1.5}
.product-row{display:flex;align-items:stretch;gap:26rpx;padding:24rpx 0;border-bottom:1rpx solid #e4e2db}.product-art{position:relative;flex:none;width:220rpx;height:220rpx;overflow:hidden;border-radius:16rpx;background:#ebe7df}.product-photo{display:block;width:100%;height:100%}.product-placeholder{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14rpx;width:100%;height:100%;color:#718078;font-size:22rpx}.product-placeholder image{width:88rpx;height:88rpx}.product-tag{position:absolute;top:0;right:0;max-width:85%;padding:7rpx 12rpx;background:#b66d3f;color:#fff;border-radius:0 16rpx 0 12rpx;font-size:22rpx;line-height:1.4;box-sizing:border-box}
.product-content{display:flex;flex-direction:column;flex:1;min-width:0;padding:2rpx 0}.product-name{font-size:31rpx;font-weight:650;line-height:1.4;overflow-wrap:break-word}.product-description{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;margin-top:6rpx;color:#69776f;font-size:24rpx;line-height:1.5}
.product-footer{display:flex;align-items:center;justify-content:space-between;gap:6rpx;margin-top:auto;padding-top:8rpx}.product-pricing{flex:1;min-width:0}.price-line{display:flex;flex-wrap:wrap;align-items:baseline;gap:10rpx}.product-price{color:#b66d3f;font-size:34rpx;font-weight:650;line-height:1.25;overflow-wrap:break-word}.product-original{color:#718078;font-size:24rpx;text-decoration:line-through}.product-member-price{display:block;color:#9b592f;margin-top:4rpx;font-size:24rpx;line-height:1.4}
.product-counter{display:flex;align-items:center;flex:none}.counter-button{display:flex;align-items:center;justify-content:center;width:84rpx;height:84rpx;min-width:44px;min-height:44px;padding:0;background:transparent;overflow:visible}.counter-button view{display:flex;align-items:center;justify-content:center;width:62rpx;height:62rpx;min-width:30px;min-height:30px;border-radius:50%;font-size:36rpx;line-height:1;box-sizing:border-box}.counter-minus view{border:1rpx solid #9da9a1;color:#5c6d63}.counter-plus view{background:#193432;color:#fff}.counter-plus[disabled] view{background:#dce2dc;color:#7c897f}.counter-minus[disabled] view{opacity:.55}.counter-quantity{min-width:30rpx;text-align:center;font-size:27rpx;font-weight:600}.product-stock{display:block;color:#69776f;font-size:24rpx;line-height:1.5;margin-top:2rpx}.stock-low{color:#a44d36}
.checkout-dock{position:fixed;left:0;right:0;bottom:0;z-index:10;display:flex;align-items:center;justify-content:space-between;gap:24rpx;min-height:124rpx;padding:18rpx 30rpx;border-top:1rpx solid #2d4b42;border-radius:24rpx 24rpx 0 0;background:#193432;color:#fffdf5;box-shadow:0 -6rpx 20rpx rgba(25,52,50,.12);box-sizing:border-box}.checkout-summary{display:flex;align-items:center;gap:26rpx;flex:1;min-width:0}.checkout-bag{position:relative;flex:none}.checkout-bag image{width:58rpx;height:58rpx}.checkout-count{position:absolute;top:-10rpx;right:-12rpx;padding:1rpx 8rpx;min-width:24rpx;border-radius:28rpx;background:#b66d3f;color:#fff;font-size:21rpx;text-align:center;line-height:1.5}.checkout-amount{min-width:0}.checkout-total{display:block;font-size:34rpx;font-weight:650;line-height:1.3;overflow-wrap:break-word}.checkout-caption{display:block;margin-top:4rpx;color:#c8d6cb;font-size:24rpx;line-height:1.4}.checkout-button{min-width:200rpx;min-height:44px;padding:16rpx 28rpx;border-radius:50rpx;background:#debd8c;color:#193432;font-size:29rpx;line-height:1.5;font-weight:600;flex:none}.checkout-button[disabled]{background:#4a6157;color:#d6dfd2}
.menu-state{display:flex;flex-direction:column;align-items:center;padding:90rpx 24rpx;text-align:center}.menu-state image{width:80rpx;height:80rpx;margin-bottom:24rpx}.state-title{font-size:30rpx;font-weight:600}.state-copy{display:block;margin-top:12rpx;color:#69776f;font-size:26rpx;line-height:1.6}.state-retry{margin-top:28rpx;padding:16rpx 36rpx;background:#193432;color:#fff;font-size:28rpx}.refresh-error{display:flex;align-items:center;gap:20rpx;padding:14rpx 0;color:#a44d36;font-size:24rpx}.refresh-error text{flex:1}.refresh-error button{padding:12rpx 20rpx;color:#193432;background:#e9eee6;font-size:24rpx}
.skeleton-row{display:flex;gap:26rpx;padding:24rpx 0}.skeleton-art{width:220rpx;height:220rpx;flex:none;background:#e6e7df;border-radius:16rpx}.skeleton-copy{flex:1;padding-top:10rpx}.skeleton-copy view{height:28rpx;margin-bottom:22rpx;border-radius:8rpx;background:#e6e7df}.skeleton-copy view:nth-child(2){width:65%}.skeleton-copy view:nth-child(3){width:40%;margin-top:48rpx}
.detail-scroll{height:55vh}.detail-placeholder{width:90rpx;height:90rpx}.detail-sheet-name{line-height:1.5;overflow-wrap:break-word}.auth-title{line-height:1.5;overflow-wrap:break-word}.auth-primary,.auth-later{min-height:44px}.auth-mask{overflow-y:auto}.auth-sheet{max-height:88vh;overflow-y:auto}
@media(max-width:350px){.menu-heading{align-items:flex-start}.heading-title{font-size:21px}.table-chip{max-width:100px;font-size:12px}.product-row{gap:18rpx}.product-art,.skeleton-art{width:204rpx;height:230rpx}.product-name{font-size:15px}.product-description,.product-stock,.product-member-price,.checkout-caption{font-size:12px}.product-footer{flex-wrap:wrap}.product-counter{margin-left:auto}.product-price{font-size:17px}.checkout-total{font-size:18px}}
.menu-page .product-row{gap:16rpx;padding:18rpx 0}.menu-page .product-art,.menu-page .skeleton-art{width:150rpx;height:166rpx}.menu-page .product-name{font-size:28rpx}.menu-page .product-description{font-size:23rpx}.menu-page .product-footer{flex-wrap:wrap}.menu-page .product-counter{margin-left:auto}.menu-page .product-price{font-size:30rpx}.menu-page .product-pricing{min-width:110rpx}.menu-page .counter-button{width:74rpx;height:74rpx}.menu-page .checkout-dock{position:relative;flex:none;border-radius:0;box-shadow:none;min-height:114rpx;padding:14rpx 24rpx}.menu-page .heading-title{font-size:36rpx}
@media(max-width:350px){.category-sidebar{width:72px}.category-tab{font-size:13px}.menu-page .product-art,.menu-page .skeleton-art{width:62px;height:76px}.menu-page .product-name{font-size:14px}.menu-page .product-stock{font-size:11px}.menu-page .product-counter{margin-top:2px}.menu-page .group-buy-entry{font-size:12px}.menu-page .member-link{font-size:11px}.menu-page .product-composition{font-size:11px}.menu-page .product-pricing{min-width:80px}}
