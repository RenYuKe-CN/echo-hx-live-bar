@import "menu-service.wxss";
@import "menu-overlays.wxss";

/* The header and checkout remain in the page flex layout; the catalog scrolls. */
.menu-page{height:100vh;display:flex;flex-direction:column;box-sizing:border-box;overflow:hidden;background:#f7f4ee}
.menu-header{flex:none;margin:16rpx 24rpx 20rpx;padding:24rpx 24rpx 20rpx;background:linear-gradient(135deg,#284c40 0%,#193b33 65%,#17352f 100%);border:1rpx solid #315346;border-radius:26rpx;box-shadow:0 8rpx 22rpx rgba(25,52,50,.12);box-sizing:border-box}
.heading-title{display:block;color:#fff8ec;font-size:38rpx;font-weight:650;line-height:1.4;overflow-wrap:break-word}
.heading-context{display:flex;align-items:center;justify-content:space-between;gap:12rpx;margin:4rpx 0 12rpx}
.table-context{display:flex;align-items:center;gap:12rpx;flex:1;min-width:0}
.table-chip{display:flex;align-items:center;gap:8rpx;min-width:0;color:#f0e9d7;font-size:24rpx;font-weight:600;line-height:1.5}
.table-chip image{width:28rpx;height:28rpx;padding:4rpx;background:#debd8c;border-radius:7rpx;flex:none}.table-chip text{min-width:0;overflow-wrap:break-word}
.context-divider{width:1rpx;height:22rpx;background:rgba(223,234,215,.25);flex:none}.heading-hint{color:#c2d2c1;font-size:22rpx;line-height:1.5;flex:none}
.menu-page .call-service{display:flex;align-items:center;justify-content:center;gap:8rpx;position:relative;flex:none;min-height:44px;padding:10rpx 16rpx;border-radius:14rpx;background:#e6cba3;color:#193432;font-size:24rpx;line-height:1.5;font-weight:600;overflow:visible}
.menu-page .call-service image{width:28rpx;height:28rpx;flex:none}.menu-page .call-service-count{position:absolute;top:0;right:-8rpx;min-width:26rpx;padding:2rpx 7rpx;border-radius:20rpx;background:#b66d3f;color:#fff;font-size:19rpx;line-height:1.3;text-align:center;box-sizing:border-box}
.menu-tools{display:flex;align-items:stretch;overflow:hidden;background:rgba(243,243,224,.07);border:1rpx solid rgba(229,234,213,.14);border-radius:18rpx}
.menu-tool{display:flex;align-items:center;gap:14rpx;flex:1;width:0;min-width:0;min-height:44px;margin:0;padding:16rpx 18rpx;background:transparent;border-radius:0;text-align:left;box-sizing:border-box}
.tool-icon{display:flex;align-items:center;justify-content:center;width:56rpx;height:56rpx;border-radius:14rpx;background:#d8c29b;flex:none}.tool-icon image{width:32rpx;height:32rpx}
.member-mark{background:#9e714b}.tool-copy{flex:1;min-width:0}.tool-title{display:block;color:#fff7e9;font-size:26rpx;font-weight:600;line-height:1.4;overflow-wrap:break-word}.tool-caption{display:block;color:#cad8c6;font-size:21rpx;line-height:1.4;margin-top:5rpx}.tool-chevron{color:#e1c395;font-size:32rpx;line-height:1;flex:none}
.menu-tool:active{background:rgba(243,243,224,.09)}.menu-page .call-service:active{opacity:.8}

.catalog-body{display:flex;flex:1;min-height:0;overflow:hidden;background:#fffefa;border-top:1rpx solid #e4e5dc}
.category-sidebar{height:100%;width:154rpx;flex:none;background:#f0eee7}
.category-tab{display:flex;align-items:center;justify-content:center;position:relative;width:100%;min-height:52px;margin:0;padding:20rpx 12rpx;background:transparent;color:#718078;border-radius:0;font-size:26rpx;line-height:1.5;white-space:normal;overflow-wrap:break-word}
.category-tab.is-active{background:#fffefa;color:#193432;font-weight:650}.category-tab.is-active::before{content:"";position:absolute;left:0;top:30%;bottom:30%;width:6rpx;border-radius:0 6rpx 6rpx 0;background:#b66d3f}
.product-scroll{height:100%;flex:1;width:0;min-width:0}.product-list,.menu-loading{padding:0 20rpx}.catalog-section-title{padding:24rpx 0 8rpx;color:#40554b;font-size:26rpx;font-weight:600;line-height:1.4}
.product-row{display:flex;align-items:stretch;gap:18rpx;padding:20rpx 0;border-bottom:1rpx solid #eeeee6}
.product-art{position:relative;flex:none;width:150rpx;height:166rpx;overflow:hidden;border-radius:16rpx;background:#f0eee6}.product-photo{display:block;width:100%;height:100%}.product-placeholder{display:flex;align-items:center;justify-content:center;width:100%;height:100%}.product-placeholder image{width:74rpx;height:74rpx}
.product-tag{position:absolute;top:0;right:0;max-width:85%;padding:6rpx 10rpx;background:#b66d3f;color:#fff;border-radius:0 16rpx 0 10rpx;font-size:20rpx;line-height:1.4;box-sizing:border-box}
.product-content{display:flex;flex-direction:column;flex:1;min-width:0;padding:2rpx 0}.product-name{color:#233631;font-size:28rpx;font-weight:600;line-height:1.45;overflow-wrap:break-word}.product-description{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;margin-top:6rpx;color:#7a867d;font-size:23rpx;line-height:1.5}
.product-footer{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:6rpx;margin-top:auto;padding-top:10rpx}.product-pricing{flex:1;min-width:112rpx}.product-price{display:block;color:#ad673d;font-size:32rpx;font-weight:650;line-height:1.3;overflow-wrap:break-word}.price-reference{display:flex;flex-wrap:wrap;align-items:baseline;gap:8rpx;margin-top:4rpx}.product-member-price{color:#78867d;font-size:21rpx;line-height:1.4}.product-original{color:#96a095;font-size:21rpx;line-height:1.4;text-decoration:line-through}
.product-counter{display:flex;align-items:center;flex:none;margin-left:auto}.counter-button{display:flex;align-items:center;justify-content:center;width:74rpx;height:74rpx;min-width:44px;min-height:44px;padding:0;background:transparent;overflow:visible}.counter-button view{display:flex;align-items:center;justify-content:center;width:58rpx;height:58rpx;min-width:30px;min-height:30px;border-radius:50%;font-size:34rpx;line-height:1;box-sizing:border-box}.counter-minus view{border:1rpx solid #bac4b8;color:#62766a}.counter-plus view{background:#193432;color:#fff}.counter-plus[disabled] view{background:#dce2dc;color:#7c897f}.counter-minus[disabled] view{opacity:.55}.counter-quantity{min-width:30rpx;text-align:center;color:#29433a;font-size:26rpx;font-weight:600}
.product-stock{display:block;color:#869287;font-size:21rpx;line-height:1.5;margin-top:4rpx}.stock-low{color:#a44d36}.product-composition{display:block;margin-top:8rpx;color:#78867d;font-size:22rpx;line-height:1.5}

.checkout-dock{position:relative;flex:none;z-index:10;display:flex;align-items:center;justify-content:space-between;gap:24rpx;min-height:114rpx;padding:14rpx 24rpx;background:#193432;color:#fffdf5;box-sizing:border-box}
.checkout-summary{display:flex;align-items:center;gap:22rpx;flex:1;min-width:0}.checkout-bag{position:relative;flex:none}.checkout-bag image{width:56rpx;height:56rpx}.checkout-count{position:absolute;top:-10rpx;right:-12rpx;padding:1rpx 8rpx;min-width:24rpx;border-radius:28rpx;background:#b66d3f;color:#fff;font-size:21rpx;text-align:center;line-height:1.5}.checkout-amount{min-width:0}.checkout-total{display:block;font-size:34rpx;font-weight:650;line-height:1.3;overflow-wrap:break-word}.checkout-caption{display:block;margin-top:4rpx;color:#c8d6cb;font-size:23rpx;line-height:1.4}.checkout-button{min-width:200rpx;min-height:44px;padding:16rpx 28rpx;border-radius:50rpx;background:#debd8c;color:#193432;font-size:29rpx;line-height:1.5;font-weight:600;flex:none}.checkout-button[disabled]{background:#4a6157;color:#d6dfd2}
.menu-state{display:flex;flex-direction:column;align-items:center;padding:60rpx 20rpx;text-align:center}.state-title{font-size:28rpx;font-weight:600}.state-copy{display:block;margin-top:12rpx;color:#78867d;font-size:24rpx;line-height:1.6}.state-retry{margin-top:28rpx;min-height:44px;padding:16rpx 30rpx;background:#193432;color:#fff;font-size:26rpx}.refresh-error{display:flex;align-items:center;gap:20rpx;padding:14rpx 0;color:#a44d36;font-size:24rpx}.refresh-error text{flex:1}.refresh-error button{min-height:44px;padding:12rpx 20rpx;color:#193432;background:#e9eee6;font-size:24rpx}
.skeleton-row{display:flex;gap:18rpx;padding:20rpx 0}.skeleton-art{width:150rpx;height:166rpx;flex:none;background:#e6e7df;border-radius:16rpx}.skeleton-copy{flex:1;padding-top:10rpx}.skeleton-copy view{height:28rpx;margin-bottom:22rpx;border-radius:8rpx;background:#e6e7df}.skeleton-copy view:nth-child(2){width:65%}.skeleton-copy view:nth-child(3){width:40%;margin-top:28rpx}
.detail-scroll{height:55vh}.detail-placeholder{width:90rpx;height:90rpx}.detail-sheet-name,.auth-title{line-height:1.5;overflow-wrap:break-word}.auth-primary,.auth-later{min-height:44px}.auth-mask{overflow-y:auto}.auth-sheet{max-height:88vh;overflow-y:auto}

@media(max-width:350px){
  .menu-header{margin:12rpx 20rpx 16rpx;padding:18rpx 18rpx 18rpx}.heading-title{font-size:18px}.table-chip,.menu-page .call-service{font-size:12px}.heading-hint{font-size:11px}.table-context{gap:9rpx}.menu-tool{padding:14rpx 14rpx;gap:10rpx}.tool-icon{width:48rpx;height:48rpx}.tool-title{font-size:12px}.tool-caption{font-size:10px}.tool-chevron{font-size:18px}
  .category-sidebar{width:72px}.category-tab{font-size:13px}.product-art,.skeleton-art{width:62px;height:76px}.product-name{font-size:14px}.product-description,.product-composition{font-size:11px}.product-price{font-size:17px}.product-stock,.product-member-price,.product-original{font-size:11px}.product-pricing{min-width:80px}.product-counter{margin-top:2px}.checkout-caption{font-size:12px}.checkout-total{font-size:18px}
}

.table-chip{margin:0;padding:0 12rpx;height:54rpx;line-height:54rpx;border:0;display:flex;align-items:center}.table-chip::after{border:0}
.table-picker-sheet{height:84vh;max-height:84vh;display:flex;flex-direction:column}.table-picker-sheet .service-head{flex:none;margin-bottom:16rpx}.table-picker-controls{flex:none}.table-picker-search{display:flex;align-items:center;background:#f0f2eb;border:1rpx solid #e1e6db;border-radius:16rpx;padding:0 18rpx;min-height:82rpx}.table-picker-search input{flex:1;min-width:0;height:82rpx;font-size:27rpx;color:#233631}.table-picker-search button{margin:0;padding:0;min-width:44px;min-height:44px;line-height:44px;font-size:34rpx;color:#69776f;background:transparent}.table-picker-filters{display:flex;gap:12rpx;padding:18rpx 0}.table-picker-filters button{flex:1;min-width:0;margin:0;padding:16rpx 4rpx;border-radius:12rpx;background:#efeee7;color:#6b786c;font-size:25rpx;line-height:1.4}.table-picker-filters button.is-active{background:#193b33;color:#fff}.table-picker-body{flex:1;height:0;min-height:0;max-height:none}.table-picker-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12rpx;padding:2rpx 0 18rpx}.table-picker-option{margin:0;padding:18rpx 8rpx;min-height:138rpx;background:#f2f6ee;border:2rpx solid #dfe9d9;border-radius:15rpx;line-height:1.4;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#274b35;font-size:30rpx;font-weight:600}.table-picker-option.is-occupied{background:#f4efe4;border-color:#e8dfcb;color:#795f3c}.table-picker-option.is-current{background:#193b33;border-color:#193b33;color:#fff}.table-picker-name{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;word-break:break-all;line-height:1.4}.table-picker-status{font-size:23rpx;font-weight:400;color:#6e7a70;margin-top:6rpx}.table-picker-option.is-current .table-picker-status{color:#d8e8dc}.table-picker-note{display:block;color:#6e7a70;font-size:24rpx;line-height:1.6;padding:12rpx 0}.table-picker-footer{flex:none;padding:16rpx 0 0;border-top:1rpx solid #e7e8df}.table-picker-empty{padding:60rpx 0;text-align:center;font-size:27rpx;color:#6e7a70}.table-picker-empty button{margin-top:18rpx;background:transparent;color:#193b33;font-size:27rpx}@media(max-width:360px){.table-picker-name{font-size:14px}.table-picker-status{font-size:11px}.table-picker-option{min-height:68px}.table-picker-filters button{font-size:12px}.table-picker-footer{font-size:11px}}

button.table-chip{background:rgba(255,255,255,.08);color:#f0e9d7;flex:none;white-space:nowrap;max-width:100%}.table-chip text{overflow:hidden;text-overflow:ellipsis}.table-context .heading-hint{flex:1;min-width:0}@media(max-width:360px){.table-context .heading-hint,.table-context .context-divider{display:none}}
