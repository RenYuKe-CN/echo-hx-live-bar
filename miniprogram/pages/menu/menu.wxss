.page{padding:34rpx 28rpx 210rpx}.hero{display:flex;justify-content:space-between;align-items:flex-end}.eyebrow{display:block;color:#a9643d;font-size:20rpx;letter-spacing:4rpx;font-weight:700}.title{display:block;color:#192c2b;font-size:44rpx;font-weight:700;line-height:1.2;margin-top:12rpx}.table{background:#fffaf4;color:#6a4b38;padding:16rpx 18rpx;border:1rpx solid #ead8c5;border-radius:14rpx;font-size:22rpx;box-shadow:0 8rpx 20rpx rgba(71,49,35,.06)}.member{display:flex;gap:18rpx;align-items:center;margin:34rpx 0 24rpx;padding:20rpx;background:#193432;color:#fff;border-radius:20rpx}.badge{width:64rpx;height:64rpx;line-height:64rpx;text-align:center;background:#d5a466;color:#fff;border-radius:18rpx;font-size:28rpx;font-weight:700}.member-title,.muted{display:block}.member-title{font-size:29rpx;font-weight:700}.muted,.detail{color:#8c9b97;font-size:22rpx;margin-top:8rpx}.member .muted{color:#b9c8c2}.tabs{white-space:nowrap;border-bottom:1rpx solid #dedbd3;padding-bottom:16rpx}.tab{display:inline-block;margin-right:38rpx;color:#899793;font-size:26rpx}.tab.active{color:#193432;font-weight:700;border-bottom:5rpx solid #bf7c4a;padding-bottom:14rpx}.products{margin-top:6rpx}.product{display:flex;gap:20rpx;padding:22rpx 0;border-bottom:1rpx solid #e5e1d9}.art{width:170rpx;height:170rpx;border-radius:20rpx;display:flex;flex-direction:column;justify-content:space-between;padding:16rpx;color:#fff;overflow:hidden;box-sizing:border-box;box-shadow:0 8rpx 16rpx rgba(46,38,31,.1)}.amber{background:#9f6032}.teal{background:#287e7b}.red{background:#9a3e47}.yellow{background:#b97b2e}.purple{background:#55467a}.pink{background:#9a5d73}.initial{font-size:54rpx;align-self:flex-end;opacity:.7}.product-info{flex:1;display:flex;flex-direction:column;justify-content:space-between;padding:4rpx 0;min-width:0}.name{font-size:30rpx;font-weight:700;color:#223936}.buy{display:flex;justify-content:space-between;align-items:center;gap:12rpx}.origin{text-decoration:line-through;color:#9ca5a5;font-size:22rpx;display:block}.member-price{color:#217c59;font-weight:700;font-size:32rpx}.counter{display:flex;align-items:center;gap:10rpx;flex:none}.counter button{width:54rpx;height:54rpx;line-height:45rpx;padding:0;background:#193432;color:#fff;font-size:34rpx}.counter text{min-width:26rpx;text-align:center;color:#193432;font-weight:700}.dock{position:fixed;left:24rpx;right:24rpx;bottom:calc(20rpx + env(safe-area-inset-bottom));background:#193432;color:#fff;border-radius:22rpx;padding:20rpx 24rpx;display:flex;justify-content:space-between;align-items:center;gap:16rpx;box-sizing:border-box;box-shadow:0 12rpx 32rpx rgba(22,47,43,.24);z-index:10}.dock>view{flex:1;min-width:0}.dock-label{display:block;color:#bbcbc4;font-size:20rpx}.strike{text-decoration:line-through;color:#9cafaa;font-size:22rpx}.dock-total{color:#f0bd8b;font-size:34rpx;font-weight:700}.dock button{flex:0 0 230rpx;width:230rpx;background:#d59b64;color:#2c211b;padding:18rpx 8rpx;white-space:nowrap;line-height:1.4;font-size:22rpx;text-align:center}.product-image{width:100%;height:100%;border-radius:14rpx}.stock{display:block;color:#687a78;font-size:21rpx;margin-top:10rpx}.stock-low{color:#b35b42;font-weight:700}.prices{display:flex;align-items:baseline;flex-wrap:wrap;gap:8rpx;flex:1;min-width:0}.prices .origin{display:inline}.regular-price{color:#223936;font-weight:700;font-size:32rpx}.reference-price{color:#217c59;font-size:21rpx}.upgrade-banner{display:flex;justify-content:space-between;gap:16rpx;margin:0 0 24rpx;padding:18rpx 20rpx;background:#fff7e9;border:1rpx solid #f0d6ae;border-radius:14rpx;font-size:23rpx;line-height:1.5}.upgrade-link{color:#a45c31;font-weight:700;flex:none}
.product-image{display:block}
.dock{left:0;right:0;bottom:0;border-radius:18rpx 18rpx 0 0;box-shadow:0 -6rpx 18rpx rgba(22,47,43,.12)}
.art.has-image{padding:0;background:transparent}
.art.has-image .product-image{border-radius:20rpx}
.detail-mask{position:fixed;inset:0;background:rgba(20,30,29,.48);z-index:30;display:flex;align-items:flex-end}.detail-sheet{width:100%;box-sizing:border-box;background:#fffaf4;border-radius:28rpx 28rpx 0 0;padding:28rpx 30rpx calc(30rpx + env(safe-area-inset-bottom));max-height:82vh}.detail-sheet-head{display:flex;justify-content:space-between;align-items:center;font-size:30rpx;font-weight:700;color:#193432}.detail-close{font-size:44rpx;font-weight:400;color:#82918c;padding:0 10rpx}.detail-sheet-art{width:100%;height:300rpx;border-radius:20rpx;margin:22rpx 0;display:flex;align-items:center;justify-content:center;color:#fff;overflow:hidden}.detail-sheet-art .product-image{border-radius:20rpx}.detail-sheet-name{display:block;color:#193432;font-size:36rpx;font-weight:700}.detail-sheet-copy{display:block;color:#647572;font-size:25rpx;line-height:1.7;margin-top:12rpx;white-space:pre-wrap}.detail-sheet-stock{display:block;color:#8a6a50;font-size:23rpx;margin-top:14rpx}.detail-sheet-foot{display:flex;align-items:center;justify-content:space-between;margin-top:24rpx}.detail-sheet-price{font-size:38rpx;font-weight:700;color:#217c59}.detail-sheet-foot button{background:#d59b64;color:#2c211b;padding:12rpx 30rpx;font-size:25rpx}
.auth-mask{position:fixed;inset:0;background:rgba(20,30,29,.58);z-index:40;display:flex;align-items:flex-end}.auth-sheet{width:100%;box-sizing:border-box;background:#fffaf4;border-radius:30rpx 30rpx 0 0;padding:42rpx 34rpx calc(34rpx + env(safe-area-inset-bottom));text-align:center}.auth-mark{display:inline-flex;align-items:center;justify-content:center;width:96rpx;height:96rpx;border-radius:30rpx;background:#193432;color:#f0bd8b;font-size:25rpx;font-weight:700}.auth-title{display:block;margin-top:24rpx;color:#193432;font-size:36rpx;font-weight:700}.auth-copy{display:block;margin:16rpx auto 28rpx;max-width:620rpx;color:#63736e;font-size:24rpx;line-height:1.65}.auth-step{border-top:1rpx solid #e5e1d9;padding-top:24rpx}.auth-step-title{display:block;color:#304441;font-size:25rpx;font-weight:600;margin-bottom:18rpx}.auth-primary{background:#193432;color:#fff;border-radius:12rpx;height:84rpx;line-height:84rpx;font-size:28rpx}.auth-later{margin-top:16rpx;background:transparent;color:#687773;font-size:24rpx}.auth-privacy{display:block;margin-top:10rpx;color:#9aa5a0;font-size:20rpx;line-height:1.5}.auth-error{display:block;color:#aa3d34;font-size:23rpx;line-height:1.5;margin-top:18rpx}
.avatar-choice{display:flex;align-items:center;gap:18rpx;width:100%;padding:0;margin:0 0 18rpx;background:transparent;color:#49645b;text-align:left;font-size:24rpx}.auth-avatar{width:92rpx;height:92rpx;border-radius:46rpx;flex:none}.auth-avatar-empty{display:flex;align-items:center;justify-content:center;background:#e4ece6;color:#647e73;font-size:23rpx}.auth-nickname{height:82rpx;padding:0 22rpx;margin-bottom:18rpx;background:#fff;border:1rpx solid #d7ded8;border-radius:10rpx;box-sizing:border-box;text-align:left;color:#304441;font-size:26rpx}
