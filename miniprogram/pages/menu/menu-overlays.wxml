<view wx:if="{{authVisible}}" class="auth-mask"><view class="auth-sheet" catchtap="noop"><view class="auth-mark">会员档案</view><text class="auth-title">欢迎来到 {{appName}}</text><text class="auth-copy">完善会员资料，方便查看余额、积分和存酒。</text><view wx:if="{{authStep === 'profile'}}" class="auth-step"><text class="auth-step-title">第一步：授权头像和昵称</text><button class="avatar-choice" open-type="chooseAvatar" bindchooseavatar="onAuthAvatar" disabled="{{authBusy}}"><image wx:if="{{authAvatarPath}}" class="auth-avatar" src="{{authAvatarPath}}" mode="aspectFill"/><view wx:else class="auth-avatar auth-avatar-empty">头像</view><text>{{authAvatarPath ? '重新选择微信头像' : '点击选择微信头像'}}</text></button><input class="auth-nickname" type="nickname" value="{{authNickname}}" placeholder="点击填写微信昵称" bindinput="onAuthNickname" disabled="{{authBusy}}"/><button class="auth-primary" bindtap="saveAuthProfile" loading="{{authBusy}}" disabled="{{authBusy}}">保存头像和昵称</button></view><view wx:if="{{authStep === 'phone'}}" class="auth-step"><text class="auth-step-title">第二步：授权手机号</text><button class="auth-primary" open-type="getPhoneNumber" bindgetphonenumber="onPhone" loading="{{authBusy}}" disabled="{{authBusy}}">授权微信手机号</button></view><text wx:if="{{authError}}" class="auth-error">{{authError}}</text><button class="auth-later" bindtap="closeAuth" disabled="{{authBusy}}">稍后完善</button><text class="auth-privacy">授权信息仅用于本店会员服务。后续可在会员页资料设置中修改。</text></view></view>
<view wx:if="{{detailProduct}}" class="detail-mask" catchtap="closeDetail"><view class="detail-sheet" catchtap="noop"><view class="detail-sheet-head"><text>商品详情</text><text class="detail-close" catchtap="closeDetail">×</text></view><scroll-view scroll-y="true" class="detail-scroll"><view class="detail-sheet-art {{detailProduct.color}}"><image wx:if="{{detailProduct.imageUrl}}" class="product-image" src="{{detailProduct.imageUrl}}" mode="aspectFill" data-id="{{detailProduct.id}}" data-src="{{detailProduct.imageUrl}}" binderror="onProductImageError"/><image wx:else class="detail-placeholder" src="{{detailProduct.placeholderIcon}}" mode="aspectFit"/></view><text class="detail-sheet-name">{{detailProduct.name}}</text><text class="detail-sheet-copy">{{detailProduct.detail || '暂无商品简介'}}</text><text class="detail-sheet-stock">剩余库存 {{detailProduct.stock}} 件</text></scroll-view><view class="detail-sheet-foot"><text class="detail-sheet-price">¥{{isMember ? detailProduct.memberPriceText : detailProduct.priceText}}</text><button bindtap="addFromDetail" loading="{{pendingProducts[detailProduct.id]}}" disabled="{{pendingProducts[detailProduct.id] || detailProduct.remainingQuantity <= 0}}">{{detailProduct.remainingQuantity <= 0 ? '已达可选数量' : '加入订单'}}</button></view></view></view>
