<view class="page">
  <view class="hero"><view><text class="eyebrow">{{appName}}</text><text class="title">{{homeTitle}}</text></view><view class="table">{{tableNo}} · 多人点单</view></view>
  <view class="member"><text class="badge">{{memberInitial}}</text><view><text class="member-title">{{isMember ? user.memberLevel : '普通会员'}}</text><text class="muted">本桌多人可同时加单</text></view></view>
  <view wx:if="{{!isMember}}" class="upgrade-banner" bindtap="upgrade"><text>是否充值余额并升级会员？</text><text class="upgrade-link">查看套餐 ›</text></view>
  <scroll-view scroll-x="true" class="tabs"><text wx:for="{{categories}}" wx:key="*this" class="tab {{category === item ? 'active' : ''}}" data-category="{{item}}" bindtap="selectCategory">{{item}}</text></scroll-view>
  <view class="products"><view wx:for="{{visibleProducts}}" wx:key="id" class="product">
    <view class="art {{item.color}} {{item.imageUrl ? 'has-image' : ''}}" data-id="{{item.id}}" bindtap="showDetail"><image wx:if="{{item.imageUrl}}" class="product-image" src="{{item.imageUrl}}" mode="aspectFill"/><block wx:else><text>{{item.tag}}</text><text class="initial">{{item.initial}}</text></block></view>
    <view class="product-info" data-id="{{item.id}}" bindtap="showDetail"><text class="name">{{item.name}}</text><text class="detail">{{item.detail}}</text><text class="stock {{item.stock <= 5 ? 'stock-low' : ''}}">剩余库存 {{item.stock}} 件</text><view class="buy" catchtap="noop">
      <view class="prices"><text wx:if="{{item.showDiscount}}" class="origin">¥{{item.priceText}}</text><text class="{{isMember ? 'member-price' : 'regular-price'}}">¥{{isMember ? item.memberPriceText : item.priceText}}</text><text class="reference-price">{{isMember ? '会员价' : '会员价 ¥' + item.referenceMemberPriceText}}</text></view>
      <view class="counter"><button wx:if="{{cartMap[item.id]}}" data-id="{{item.id}}" data-delta="-1" bindtap="change">−</button><text wx:if="{{cartMap[item.id]}}">{{cartMap[item.id]}}</text><button data-id="{{item.id}}" data-delta="1" bindtap="change">+</button></view>
    </view></view>
  </view></view>
  <view class="dock"><view class="dock-prices"><text class="dock-label">{{couponCheckout ? '使用优惠券后待支付' : '待支付 · ' + (isMember ? '会员价' : '原价')}}</text><text><text wx:if="{{couponCheckout || (isMember && totals.discount > 0)}}" class="strike">¥{{couponCheckout ? couponCheckout.originalText : totals.originalText}}</text><text class="dock-total"> ¥{{couponCheckout ? couponCheckout.payableText : totals.memberText}}</text></text><text wx:if="{{couponCheckout}}" class="dock-coupon-discount">会员优惠 ¥{{couponCheckout.memberDiscountText}} · 券优惠 ¥{{couponCheckout.couponDiscountText}}</text></view><button bindtap="preview">支付本桌订单 ({{totalQty}})</button></view>
</view>
<view wx:if="{{authVisible}}" class="auth-mask"><view class="auth-sheet" catchtap="noop"><view class="auth-mark">会员档案</view><text class="auth-title">欢迎来到 {{appName}}</text><text class="auth-copy">请在当前页面完成微信官方授权，用于展示头像、昵称，并用手机号识别您的会员余额、积分和存酒。</text><view wx:if="{{authStep === 'profile'}}" class="auth-step"><text class="auth-step-title">第一步：授权头像和昵称</text><button class="avatar-choice" open-type="chooseAvatar" bindchooseavatar="onAuthAvatar" disabled="{{authBusy}}"><image wx:if="{{authAvatarPath}}" class="auth-avatar" src="{{authAvatarPath}}" mode="aspectFill"/><view wx:else class="auth-avatar auth-avatar-empty">头像</view><text>{{authAvatarPath ? '重新选择微信头像' : '点击选择微信头像'}}</text></button><input class="auth-nickname" type="nickname" value="{{authNickname}}" placeholder="点击填写微信昵称" bindinput="onAuthNickname" disabled="{{authBusy}}"/><button class="auth-primary" bindtap="saveAuthProfile" loading="{{authBusy}}" disabled="{{authBusy}}">保存头像和昵称</button></view><view wx:if="{{authStep === 'phone'}}" class="auth-step"><text class="auth-step-title">第二步：授权手机号</text><button class="auth-primary" open-type="getPhoneNumber" bindgetphonenumber="onPhone" loading="{{authBusy}}" disabled="{{authBusy}}">授权微信手机号</button></view><text wx:if="{{authError}}" class="auth-error">{{authError}}</text><text class="auth-privacy">授权信息仅用于本店会员服务。后续可在会员页资料设置中修改。</text></view></view>
<view wx:if="{{detailProduct}}" class="detail-mask" catchtap="closeDetail"><view class="detail-sheet" catchtap="noop"><view class="detail-sheet-head"><text>商品详情</text><text class="detail-close" catchtap="closeDetail">×</text></view><view class="detail-sheet-art {{detailProduct.color}}"><image wx:if="{{detailProduct.imageUrl}}" class="product-image" src="{{detailProduct.imageUrl}}" mode="aspectFill"/><text wx:else class="initial">{{detailProduct.initial}}</text></view><text class="detail-sheet-name">{{detailProduct.name}}</text><text class="detail-sheet-copy">{{detailProduct.detail || '暂无商品简介'}}</text><text class="detail-sheet-stock">剩余库存 {{detailProduct.stock}} 件</text><view class="detail-sheet-foot"><text class="detail-sheet-price">¥{{isMember ? detailProduct.memberPriceText : detailProduct.priceText}}</text><button bindtap="addFromDetail">加入订单</button></view></view></view>
