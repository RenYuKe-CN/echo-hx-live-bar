.heading-actions{display:flex;flex-direction:column;align-items:flex-end;gap:8rpx;flex:none}.call-service{display:flex;align-items:center;gap:8rpx;position:relative;min-height:44px;padding:8rpx 16rpx;border-radius:30rpx;color:#193432;background:#e7ede4;font-size:24rpx;line-height:1.4}.call-service image{width:30rpx;height:30rpx}.call-service-count{background:#a85b35;color:#fff;border-radius:18rpx;padding:0 8rpx;font-size:20rpx}
.service-mask{position:fixed;inset:0;z-index:35;background:rgba(17,35,31,.5);display:flex;align-items:flex-end}.service-sheet{width:100%;box-sizing:border-box;padding:26rpx 30rpx calc(30rpx + env(safe-area-inset-bottom));border-radius:30rpx 30rpx 0 0;background:#fdfbf6}.service-head{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-bottom:22rpx}.service-title{display:block;color:#193432;font-size:36rpx;font-weight:600;line-height:1.4}.service-subtitle{display:block;color:#69776f;font-size:24rpx;line-height:1.5;margin-top:6rpx;overflow-wrap:break-word}.service-head button{background:transparent;font-size:42rpx;min-height:44px;min-width:44px;padding:0;color:#69776f}.service-body{height:58vh}.service-choices{display:flex;flex-wrap:wrap;gap:14rpx;margin-bottom:26rpx}.service-choice{background:#eeeae3;color:#55645c;border-radius:14rpx;padding:16rpx 20rpx;min-height:44px;font-size:26rpx;line-height:1.5}.service-choice.chosen{background:#193432;color:#fff}.service-note-label{display:block;font-size:28rpx;color:#233631;font-weight:600;margin:14rpx 0}.service-note{width:100%;height:170rpx;background:#fff;border:1rpx solid #d8ded4;border-radius:16rpx;padding:20rpx;box-sizing:border-box;font-size:27rpx;line-height:1.6}.service-copy{display:block;color:#69776f;font-size:24rpx;line-height:1.6;margin:18rpx 0}.service-submit{width:100%;background:#193432;color:#fff;font-size:29rpx;min-height:44px;padding:20rpx;margin-top:22rpx;line-height:1.5}.service-error{color:#a44d36;font-size:25rpx;line-height:1.5;background:#f8ebe3;padding:16rpx;border-radius:12rpx}.service-error button{display:inline-block;background:transparent;color:#193432;font-size:25rpx;padding:12rpx 0}.service-record{padding:20rpx 0;border-bottom:1rpx solid #e7e4dc}.service-record-top{display:flex;align-items:center;justify-content:space-between;gap:16rpx;font-size:27rpx;color:#233631}.service-status{font-size:23rpx;color:#9b592f;flex:none}.service-status.completed{color:#627e67}.service-record-note{display:block;font-size:25rpx;color:#55645c;white-space:pre-wrap;line-height:1.6;margin-top:8rpx}.service-owner{display:block;font-size:23rpx;color:#69776f;margin-top:8rpx;line-height:1.5}
