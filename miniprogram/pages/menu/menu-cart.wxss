.cart-preview-mask{position:fixed;inset:0;z-index:60;background:rgba(18,35,30,.5);display:flex;align-items:flex-end}
.cart-preview-backdrop{position:absolute;inset:0}.cart-preview-sheet{position:relative;z-index:1;width:100%;max-height:85vh;display:flex;flex-direction:column;box-sizing:border-box;background:#fffaf4;border-radius:28rpx 28rpx 0 0;padding:14rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));overflow:hidden}
.cart-preview-handle{flex:none;width:62rpx;height:6rpx;border-radius:4rpx;background:#d7dcd4;margin:0 auto 12rpx}
.cart-preview-head{display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:0 0 20rpx;flex:none}.cart-preview-head>view{flex:1;min-width:0}
.cart-preview-title{display:block;color:#193432;font-size:34rpx;font-weight:650;line-height:1.5}.cart-preview-table{display:block;color:#7a887f;font-size:24rpx;line-height:1.5;overflow-wrap:anywhere;margin-top:4rpx}
button.cart-preview-close{width:44px;min-width:44px;height:44px;padding:0;margin:0;background:transparent;font-size:38px;line-height:44px;font-weight:300;color:#6c7f73}
.cart-reservation{flex:none;display:flex;align-items:center;justify-content:space-between;gap:14rpx;margin-bottom:16rpx;padding:16rpx 18rpx;background:#edf3ed;color:#4c6a57;border-radius:14rpx;font-size:22rpx;line-height:1.5}.cart-reservation text{flex:1;min-width:0}.cart-reservation.expired{background:#fff0de;color:#965f32}.cart-reservation button{flex:none;width:auto;min-height:44px;padding:10rpx 14rpx;background:#193432;color:white;font-size:22rpx;line-height:1.5}
.cart-preview-scroll{min-height:0;height:48vh;flex:1}.cart-preview-row{display:flex;gap:18rpx;padding:22rpx 0;border-bottom:1rpx solid #e9e9df}.cart-preview-image{flex:none;width:108rpx;height:108rpx;border-radius:14rpx;background:#eaf0e8}.cart-preview-placeholder{display:flex;align-items:center;justify-content:center;color:#71816c;font-size:38rpx}.cart-preview-info{flex:1;min-width:0}.cart-preview-name{display:block;font-size:28rpx;line-height:1.5;font-weight:600;color:#283d32;overflow-wrap:anywhere}.cart-preview-voucher{display:block;margin-top:4rpx;font-size:22rpx;line-height:1.5;color:#8e6d43}.cart-preview-actions{display:flex;align-items:center;justify-content:space-between;gap:8rpx;flex-wrap:wrap;margin-top:8rpx}.cart-preview-price{color:#ab693e;font-size:30rpx;font-weight:600}.cart-preview-sheet button.counter-button{width:44px;min-width:44px;min-height:44px;margin:0;padding:0}
.cart-preview-footer{flex:none;display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding-top:22rpx;border-top:1rpx solid #e4e7dc}.cart-preview-footer>view{flex:1;min-width:0}.cart-preview-total{display:block;color:#193432;font-weight:700;font-size:38rpx;line-height:1.4}.cart-preview-caption{display:block;font-size:20rpx;color:#819083;line-height:1.5;margin-top:4rpx}.cart-preview-footer button.cart-preview-checkout{flex:none;width:auto;min-height:44px;padding:18rpx 34rpx;margin:0;background:#193432;color:#fff;font-weight:600;font-size:27rpx;line-height:1.5;border-radius:40rpx}.cart-preview-footer button[disabled]{background:#dfe4db;color:#8b958a}
.cart-preview-empty{padding:64rpx 0;text-align:center;color:#445b4b}.cart-preview-empty text{display:block;font-size:28rpx;line-height:1.5}.cart-preview-empty text+text{margin-top:12rpx;font-size:24rpx;color:#889386}.cart-preview-empty button{width:auto;min-height:44px;display:inline-flex;align-items:center;justify-content:center;margin:24rpx 0 0;padding:12rpx 34rpx;background:#edf1e8;color:#39533f;font-size:25rpx}
.inventory-warning{display:flex;align-items:center;justify-content:space-between;gap:12rpx;flex:none;font-size:22rpx;line-height:1.4;color:#96623b;background:#fff0dd;padding:4rpx 20rpx}.inventory-warning button{width:auto;min-height:44px;margin:0;padding:8rpx 12rpx;background:transparent;font-size:24rpx;color:#284d38;line-height:1.5}
