.page{min-height:100vh;padding:28rpx 28rpx 60rpx;background:#f8f8f5;color:#304441;box-sizing:border-box}.hero{padding:28rpx 26rpx;background:#193432;color:#fff;border-radius:20rpx;box-shadow:0 10rpx 24rpx rgba(25,52,50,.14)}.hero-top{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.hero-label{font-size:22rpx;color:#b9c9c2}.status{padding:7rpx 14rpx;border-radius:999rpx;background:#e7f3ec;color:#217c59;font-size:22rpx}.order-no{display:block;margin-top:18rpx;font-size:32rpx;font-weight:700;word-break:break-all}.table{display:block;margin-top:12rpx;color:#c9d7d0;font-size:23rpx}.section{margin-top:18rpx;padding:24rpx;background:#fff;border:1rpx solid #e8e3da;border-radius:18rpx;box-shadow:0 5rpx 16rpx rgba(39,53,48,.04)}.section-title{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-bottom:18rpx;font-size:29rpx;font-weight:700}.section-title text:last-child{font-size:22rpx;color:#899793;font-weight:400}.item{display:flex;align-items:center;gap:16rpx;padding:16rpx 0;border-top:1rpx solid #edf0eb}.item:first-of-type{border-top:0;padding-top:0}.item-image-wrap{width:106rpx;height:106rpx;flex:none;border-radius:14rpx;overflow:hidden;background:#edf0eb}.item-image{width:100%;height:100%;display:block}.item-placeholder{width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:#87968f;font-size:34rpx}.item-main{min-width:0;flex:1}.item-name{display:block;color:#304441;font-size:26rpx;font-weight:700;line-height:1.4;word-break:break-all}.item-meta,.item-original{display:block;margin-top:8rpx;color:#82918c;font-size:21rpx;line-height:1.4}.item-original{margin-top:4rpx;color:#a5aaa5;text-decoration:line-through}.item-price{display:flex;flex-direction:column;align-items:flex-end;gap:5rpx;flex:none}.item-strike{color:#a5aaa5;font-size:20rpx;text-decoration:line-through}.item-total{color:#217c59;font-size:26rpx;font-weight:700}.amount-row,.info-row{display:flex;justify-content:space-between;align-items:flex-start;gap:24rpx;padding:10rpx 0;color:#687773;font-size:24rpx;line-height:1.5}.amount-row text:last-child,.info-row text:last-child{text-align:right;word-break:break-all}.amount-row.discount{color:#217c59}.amount-row.total{margin-top:10rpx;padding-top:18rpx;border-top:1rpx solid #edf0eb;color:#304441;font-size:29rpx;font-weight:700}.amount-row.total text:last-child{color:#bd6c1f}.refund-apply-section{border-color:#ead6c3;background:#fffaf5}.refund-apply-section .section-title{color:#5d493e}.refund-hint{display:block;margin:-4rpx 0 18rpx;color:#8d7b70;font-size:22rpx;line-height:1.55}.refund-item{display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:18rpx 0;border-top:1rpx solid #f0e4d9}.refund-item:first-of-type{border-top:0;padding-top:0}.refund-item-main{min-width:0;flex:1}.refund-item-main .item-name{color:#5d493e}.quantity-stepper{display:flex;align-items:center;justify-content:space-between;gap:14rpx;min-width:190rpx;flex:none}.quantity-stepper text{min-width:34rpx;text-align:center;color:#5d493e;font-size:27rpx;font-weight:700}.stepper-button{margin:0;padding:0;width:58rpx;height:58rpx;line-height:54rpx;border:1rpx solid #dfc8b3;border-radius:12rpx;background:#fff;color:#a4622e;font-size:34rpx;font-weight:400}.refund-estimate{display:flex;align-items:center;justify-content:space-between;margin-top:16rpx;padding-top:18rpx;border-top:1rpx solid #eadccf;color:#725f53;font-size:25rpx}.refund-estimate text:last-child{color:#bd6c1f;font-size:31rpx;font-weight:700}.refund-submit{margin:20rpx 0 0;height:76rpx;line-height:76rpx;border-radius:14rpx;background:#a4622e;color:#fff;font-size:27rpx}.refund-submit[disabled]{opacity:.55}.note{display:block;padding:14rpx 16rpx;background:#fff8ef;border-radius:10rpx;color:#745940;font-size:24rpx;line-height:1.6;white-space:pre-wrap}.reason{margin-top:12rpx;padding:12rpx 14rpx;background:#fff7f3;border-radius:10rpx;color:#9a604b;font-size:22rpx;line-height:1.5}.loading,.empty{text-align:center;padding:100rpx 30rpx;color:#899793}.empty-inline{text-align:center;padding:24rpx;color:#899793;font-size:23rpx}
