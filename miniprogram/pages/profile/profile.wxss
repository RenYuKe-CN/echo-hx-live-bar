.page{padding:48rpx 36rpx 80rpx;min-height:100vh;box-sizing:border-box}.heading{display:flex;flex-direction:column;gap:14rpx;margin-bottom:46rpx}.eyebrow{font-size:22rpx;color:#a26042;font-weight:700}.title{font-size:44rpx;font-weight:700;color:#193432}.intro{font-size:26rpx;color:#60706b;line-height:1.6}.fields,.phone-section,.birthday-section{border-top:1rpx solid #d7ded8;padding-top:28rpx;margin-top:32rpx}.field-label{font-size:26rpx;color:#283d36;font-weight:600;margin-bottom:18rpx}.avatar-picker{display:flex;align-items:center;gap:20rpx;background:transparent;text-align:left;padding:0;color:#49645b;font-size:25rpx;margin-bottom:32rpx}.avatar{width:104rpx;height:104rpx;border-radius:52rpx;flex-shrink:0}.placeholder{display:flex;align-items:center;justify-content:center;color:#647e73;background:#e4ece6;font-size:48rpx}.nickname{height:90rpx;padding:0 24rpx;background:#fff;border:1rpx solid #d7ded8;border-radius:8rpx;box-sizing:border-box;margin-bottom:28rpx}.primary{background:#193432;color:#fff;height:88rpx;line-height:88rpx;font-size:28rpx;font-weight:600;border-radius:8rpx}.primary[disabled]{background:#b7c4bd;color:#f5f6f5}.picker-value{height:78rpx;line-height:78rpx;padding:0 24rpx;border:1rpx solid #d7ded8;border-radius:8rpx;color:#445c52;background:#fff;display:flex;justify-content:space-between}.birthday-picker-row{margin-top:18rpx}.lunar-row{display:flex;gap:16rpx}.lunar-row picker{flex:1}.birthday-locked{padding:20rpx 24rpx;border:1rpx solid #d7ded8;border-radius:8rpx;background:#f3f6f3;color:#283d36;font-size:28rpx}.birthday-picker-row{margin-top:18rpx}.lunar-row{display:flex;gap:16rpx}.lunar-row picker{flex:1}.birthday-hint{display:block;margin-top:12rpx;color:#60706b;font-size:22rpx}.birthday-actions{display:flex;align-items:center;gap:20rpx;margin-top:18rpx}.birthday-save{flex:1}.clear-birthday{background:transparent;color:#a26042;text-align:left;padding:10rpx 0;margin:8rpx 0 0;font-size:23rpx}.phone-hint{display:block;color:#60706b;font-size:24rpx;line-height:1.6;margin-bottom:24rpx}.phone-value{font-size:30rpx;font-weight:600;color:#267555}.secondary{display:block;color:#60706b;font-size:23rpx;margin-top:14rpx}.error{color:#aa3d34;font-size:25rpx;line-height:1.5;margin-top:30rpx}

.eyebrow{line-height:1.5;overflow-wrap:break-word}
