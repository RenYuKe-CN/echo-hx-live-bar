<view class="page">
  <view class="heading"><text class="eyebrow">{{appName}}</text><text class="title">{{phoneOnly ? '绑定手机号' : '资料设置'}}</text><text class="intro">{{phoneOnly ? '下单前需绑定手机号，用于查询订单和处理售后。绑定成功后返回原页面，继续确认订单。' : '下单前需绑定手机号。头像、昵称和生日可单独完善，仅在您主动操作后保存。'}}</text></view>
  <view class="phone-section">
    <view class="field-label">会员手机号</view>
    <text class="phone-hint">手机号用于订单查询、会员查找、储值及存酒核对，仅在您点击授权后获取。</text>
    <text wx:if="{{phone}}" class="phone-value">{{phone}}</text>
    <button wx:else class="primary phone-button" open-type="getPhoneNumber" bindgetphonenumber="onPhone" disabled="{{busy}}" loading="{{busy}}">授权微信手机号</button>
    <button wx:if="{{phone && phoneOnly}}" class="primary phone-button" bindtap="returnToOrder">返回继续操作</button>
  </view>
  <view wx:if="{{!phoneOnly}}" class="fields">
    <view class="field-label">会员头像</view>
    <button class="avatar-picker" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" disabled="{{busy}}">
      <image wx:if="{{avatarPath}}" src="{{avatarPath}}" mode="aspectFill" class="avatar"/>
      <view wx:else class="avatar placeholder">＋</view>
      <text>{{avatarPath ? '更换头像' : '选择头像'}}</text>
    </button>
    <view class="field-label">会员昵称</view>
    <input class="nickname" type="nickname" value="{{nickname}}" maxlength="50" placeholder="输入您的昵称" bindinput="onNicknameInput" disabled="{{busy}}"/>
    <button class="primary" bindtap="saveProfile" loading="{{busy}}" disabled="{{busy}}">{{profileSaved ? '更新头像和昵称' : '保存头像和昵称'}}</button>
  </view>
  <view wx:if="{{!phoneOnly}}" class="birthday-section">
    <view class="field-label">生日（可选）</view>
    <view wx:if="{{birthdayLocked}}" class="birthday-locked"><text>{{birthdayType === 'lunar' ? '农历' : '阳历'}} {{birthdayDate}}</text><text class="birthday-hint">生日已设置，如需调整请联系管理员。</text></view>
    <block wx:else>
      <picker mode="selector" range="{{birthdayTypes}}" value="{{birthdayTypeIndex}}" bindchange="onBirthdayTypeChange">
        <view class="picker-value">{{birthdayTypes[birthdayTypeIndex]}} <text>⌄</text></view>
      </picker>
      <view wx:if="{{birthdayType === 'solar'}}" class="birthday-picker-row"><picker mode="date" fields="day" value="{{solarBirthday}}" start="1900-01-01" end="2100-12-31" bindchange="onSolarBirthdayChange"><view class="picker-value">{{birthdayDate}} <text>⌄</text></view></picker></view>
      <view wx:if="{{birthdayType === 'lunar'}}" class="birthday-picker-row lunar-row"><picker mode="selector" range="{{lunarMonths}}" value="{{lunarMonthIndex}}" bindchange="onLunarMonthChange"><view class="picker-value">{{lunarMonth}} 月 <text>⌄</text></view></picker><picker mode="selector" range="{{lunarDays}}" value="{{lunarDayIndex}}" bindchange="onLunarDayChange"><view class="picker-value">{{lunarDay}} 日 <text>⌄</text></view></picker></view>
      <text wx:if="{{birthdayType === 'lunar'}}" class="birthday-hint">闰月生日按对应的普通月份提醒。</text>
      <text wx:if="{{birthdayType === 'solar' && birthdayDate === '02-29'}}" class="birthday-hint">2 月 29 日仅在闰年提醒。</text>
      <view class="birthday-actions"><button class="primary birthday-save" bindtap="saveBirthday" loading="{{busy}}" disabled="{{busy}}">保存生日</button></view>
    </block>
  </view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
</view>
