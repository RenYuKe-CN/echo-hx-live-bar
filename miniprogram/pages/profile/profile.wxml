<view class="page">
  <view class="heading"><text class="eyebrow">ECHO HX LIVE BAR</text><text class="title">资料设置</text><text class="intro">登录和点单不受资料设置影响。头像、昵称和手机号仅在您主动操作后保存到本店会员档案。</text></view>
  <view class="fields">
    <view class="field-label">会员头像</view>
    <button class="avatar-picker" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" disabled="{{busy}}">
      <image wx:if="{{avatarPath}}" src="{{avatarPath}}" mode="aspectFill" class="avatar"/>
      <view wx:else class="avatar placeholder">＋</view>
      <text>{{avatarPath ? '更换头像' : '选择头像'}}</text>
    </button>
    <view class="field-label">会员昵称</view>
    <input class="nickname" type="nickname" value="{{nickname}}" maxlength="50" placeholder="输入您的昵称" bindinput="onNicknameInput" disabled="{{busy}}"/>
    <button class="primary" bindtap="saveProfile" loading="{{busy}}" disabled="{{busy}}">{{profileSaved ? '更新头像和昵称' : '保存头像和昵称'}}</button>
  </view>
  <view class="phone-section">
    <view class="field-label">会员手机号</view>
    <text class="phone-hint">手机号用于会员查找、储值及存酒核对，仅在您点击授权后获取。</text>
    <text wx:if="{{phone}}" class="phone-value">{{phone}}</text>
    <button wx:else class="primary phone-button" open-type="getPhoneNumber" bindgetphonenumber="onPhone" disabled="{{!profileSaved || busy}}" loading="{{busy}}">授权微信手机号</button>
    <text wx:if="{{!profileSaved && !phone}}" class="secondary">请先保存头像和昵称</text>
  </view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
</view>
