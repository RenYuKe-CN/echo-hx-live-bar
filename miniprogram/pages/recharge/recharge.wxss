.page{padding:34rpx 28rpx 50rpx}.title{font-size:42rpx;font-weight:700;color:#193432;margin-bottom:12rpx}.package{background:#fff;border:1rpx solid #e8e3da;border-radius:20rpx;padding:28rpx;margin-bottom:15rpx;box-shadow:0 6rpx 18rpx rgba(39,53,48,.05)}.name{font-size:30rpx;font-weight:700;color:#304441}.amount{display:flex;justify-content:space-between;margin-top:20rpx;font-size:26rpx;color:#5e706b}.amount text:last-child,.bonus{color:#217c59;font-weight:700}.bonus{display:block;margin-top:12rpx;font-size:23rpx}.notice{color:#68777a;background:#fff7e9;border:1rpx solid #f0d6ae;border-radius:14rpx;padding:18rpx 20rpx;font-size:23rpx;line-height:1.7;margin-top:28rpx}.empty{text-align:center;padding:60rpx;color:#899497}
