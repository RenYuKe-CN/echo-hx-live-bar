<view class="page"><view class="heading"><text>通知消息</text><button size="mini" bindtap="readAll">全部已读</button></view><view class="subscribe-row"><view><text>接收活动与订单提醒</text><text class="subscribe-hint">需要你主动授权，商家不会获取其他权限</text></view><button size="mini" loading="{{subscribing}}" bindtap="subscribe">开启提醒</button></view><view wx:for="{{messages}}" wx:key="id" class="message {{!item.read_at ? 'unread' : ''}}" data-id="{{item.id}}" bindtap="read"><view class="title"><text>{{item.title}}</text><text wx:if="{{!item.read_at}}" class="dot"></text></view><text class="content">{{item.content}}</text><view class="message-foot"><text class="date">{{item.created_at}}</text><button wx:if="{{item.read_at}}" size="mini" class="delete-message" data-id="{{item.id}}" catchtap="remove">删除</button></view></view><view wx:if="{{!messages.length}}" class="empty">暂无消息</view><view wx:if="{{busy}}" class="empty">加载中...</view></view>
