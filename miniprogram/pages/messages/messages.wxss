.page{padding:28rpx;background:#f5f6f3;min-height:100vh;box-sizing:border-box}.heading{display:flex;align-items:center;justify-content:space-between;font-weight:700;font-size:35rpx;color:#263f39;margin-bottom:20rpx}.heading button{margin:0;color:#287755;background:#fff}.subscribe-row{display:flex;align-items:center;justify-content:space-between;background:#e8f3ed;padding:20rpx;margin-bottom:18rpx;border-radius:8rpx;color:#285a43}.subscribe-row button{margin:0;color:#287755;background:#fff}.subscribe-hint{display:block;color:#6d8178;font-size:21rpx;margin-top:7rpx}.message{background:#fff;padding:25rpx;margin-bottom:14rpx;border-radius:8rpx;border-left:5rpx solid transparent}.message.unread{border-left-color:#2b815d}.title{display:flex;justify-content:space-between;font-size:29rpx;font-weight:700;color:#263f39}.dot{width:14rpx;height:14rpx;background:#c15741;border-radius:50%}.content{display:block;color:#536560;font-size:25rpx;line-height:1.5;margin:12rpx 0}.message-foot{display:flex;align-items:center;justify-content:space-between}.date{font-size:21rpx;color:#84918b}.delete-message{margin:0;padding:0 16rpx;height:46rpx;line-height:46rpx;color:#a24f3d;background:#fff4ef;font-size:20rpx}.empty{text-align:center;color:#84918b;padding:100rpx 0}
