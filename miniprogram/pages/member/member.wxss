.page{padding:30rpx 28rpx 50rpx}.profile{background:#193432;color:#fff;padding:34rpx 30rpx;border-radius:24rpx;box-shadow:0 12rpx 28rpx rgba(25,52,50,.2)}.profile-top{display:flex;align-items:flex-start;justify-content:space-between;gap:18rpx}.identity{display:flex;align-items:center;gap:24rpx;min-width:0}.profile-settings{flex:none;background:rgba(255,255,255,.12);color:#fff;border:1rpx solid rgba(255,255,255,.32);border-radius:24rpx;font-size:22rpx;height:52rpx;line-height:50rpx;padding:0 18rpx}.avatar{width:108rpx;height:108rpx;border-radius:54rpx;flex:none;border:4rpx solid rgba(255,255,255,.35)}.fallback{display:flex;align-items:center;justify-content:center;background:#c77f52;font-size:44rpx}.name{display:block;font-size:38rpx;font-weight:700}.badge-row{display:flex;align-items:center;gap:12rpx;margin-top:8rpx}.badge{display:inline-block;color:#fff;font-size:23rpx;line-height:38rpx;padding:0 12rpx;border-radius:19rpx;max-width:190rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.badge-arrow{color:#f1c58f;font-size:21rpx}.expiry{display:block;color:#b9c9c2;font-size:22rpx;margin-top:6rpx}.balances{display:flex;border-top:1rpx solid #49635e;margin-top:32rpx;padding-top:26rpx}.balances view{width:33.33%;display:flex;flex-direction:column;gap:9rpx;min-width:0}.balances text{font-size:22rpx;color:#b9c9c2}.balances .balance-value{font-size:30rpx;color:#fff;font-weight:700}.entry-grid{display:grid;grid-template-columns:repeat(3,1fr);background:#fff;margin-top:24rpx;padding:18rpx 0;border-radius:20rpx;box-shadow:0 6rpx 20rpx rgba(39,53,48,.06)}.entry{height:158rpx;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:12rpx;font-size:24rpx;color:#304441}.entry-icon{width:68rpx;height:68rpx;border-radius:20rpx;background:#e3f1e9;color:#267555;display:flex;align-items:center;justify-content:center;font-size:30rpx;font-weight:700}.icon-bottle,.icon-glass{background:#f8e8d8;color:#a75a2a}.icon-wallet,.icon-card{background:#e2eef0;color:#396c7b}.icon-receipt,.icon-bag{background:#eeebf5;color:#6d6189}
.entry-icon{position:relative}.entry-count{position:absolute;top:-14rpx;right:-24rpx;min-width:26rpx;height:30rpx;padding:0 6rpx;border-radius:18rpx;background:#ba533c;color:#fff;font-size:19rpx;line-height:30rpx;text-align:center}
