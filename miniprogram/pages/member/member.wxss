.member-page{padding:26rpx 28rpx 48rpx;box-sizing:border-box}.page-title{display:block;margin-bottom:26rpx;font-size:42rpx;font-weight:700;line-height:1.35}
.membership-card{position:relative;overflow:hidden;border-radius:26rpx;background:linear-gradient(135deg,#193d36,#102724);color:#fffdf5;padding:30rpx 30rpx 18rpx;box-shadow:0 12rpx 28rpx rgba(25,52,50,.13)}
.card-lines{position:absolute;width:550rpx;height:740rpx;right:-230rpx;top:-280rpx;transform:rotate(-28deg);pointer-events:none}.card-lines view{position:absolute;width:550rpx;height:740rpx;border:1rpx solid rgba(222,189,140,.19);border-radius:46%}.card-lines view:nth-child(2){left:15rpx;top:14rpx}.card-lines view:nth-child(3){left:30rpx;top:28rpx}
.card-brand{position:relative;display:block;margin-bottom:30rpx;font-size:25rpx;letter-spacing:1rpx;line-height:1.5;color:#efdfc6;text-align:right;overflow-wrap:break-word}
.profile-top{position:relative;display:flex;align-items:flex-start;justify-content:space-between;gap:16rpx}.identity{display:flex;align-items:center;gap:20rpx;flex:1;min-width:0}.avatar{width:108rpx;height:108rpx;border-radius:50%;flex:none;border:2rpx solid rgba(240,223,192,.45);box-sizing:border-box}.avatar-fallback{display:flex;align-items:center;justify-content:center;background:#eddbb8;color:#193432;font-family:Georgia,serif;font-size:48rpx}.identity-copy{min-width:0;flex:1}.member-name{display:block;font-size:34rpx;font-weight:600;line-height:1.4;overflow-wrap:break-word}.member-level{display:flex;align-items:center;gap:8rpx;margin-top:8rpx;font-size:23rpx;line-height:1.5}.member-level image{width:28rpx;height:28rpx;flex:none}.member-level text{overflow-wrap:break-word}.member-expiry{display:block;color:#d0dace;font-size:24rpx;line-height:1.5;margin-top:8rpx}
.profile-settings{display:flex;align-items:center;justify-content:center;gap:8rpx;flex:none;min-height:44px;padding:0 2rpx;background:transparent;color:#ede5d7;font-size:24rpx;line-height:1.5;max-width:158rpx}.profile-settings image{width:30rpx;height:30rpx;flex:none}
.account-metrics{position:relative;display:flex;margin-top:32rpx;padding-top:28rpx;border-top:1rpx solid rgba(225,230,214,.2)}.account-metric{flex:1;min-width:0;padding:0 16rpx;border-left:1rpx solid rgba(225,230,214,.2)}.account-metric:first-child{padding-left:0;border:0;flex:1.1}.account-metric:last-child{padding-right:0;flex:.85}.metric-label{display:block;color:#d0dace;font-size:24rpx;line-height:1.5}.metric-value{display:block;color:#fffdf5;font-size:34rpx;line-height:1.5;margin-top:8rpx;overflow-wrap:break-word}.metric-long{font-size:28rpx}.tier-link{position:relative;display:flex;align-items:center;gap:12rpx;width:100%;min-height:44px;margin-top:14rpx;padding:12rpx 0 0;background:transparent;color:#debd8c;text-align:left;font-size:24rpx;line-height:1.5}.chevron{font-size:36rpx}
.section-title{display:block;margin:38rpx 0 22rpx;font-size:33rpx;line-height:1.4;font-weight:600}.primary-services{display:flex;align-items:stretch;gap:16rpx;margin-bottom:20rpx}.primary-service{display:flex;align-items:center;gap:16rpx;flex:1;min-width:0;min-height:134rpx;padding:22rpx 20rpx;background:#fffdfa;border-radius:20rpx;line-height:1.4;text-align:left;box-sizing:border-box}.service-icon{position:relative;flex:none}.service-icon image{width:56rpx;height:56rpx}.primary-copy{flex:1;min-width:0}.service-title{display:block;color:#233631;font-size:27rpx;line-height:1.5;overflow-wrap:break-word}.service-description{display:block;color:#69776f;font-size:24rpx;line-height:1.5;margin-top:4rpx}.service-chevron{color:#69776f;font-size:32rpx;flex:none;margin-left:auto}.service-grid{display:flex;flex-wrap:wrap;background:#fffdfa;border-radius:20rpx;overflow:hidden}.service-entry{display:flex;align-items:center;gap:18rpx;width:50%;min-height:140rpx;padding:24rpx 22rpx;background:transparent;text-align:left;line-height:1.5;border-radius:0;border-top:1rpx solid #eeece5;box-sizing:border-box}.service-entry:nth-child(-n+2){border-top:0}.service-entry:nth-child(2n){border-left:1rpx solid #eeece5}.service-entry .service-title{flex:1;min-width:0}.entry-count{position:absolute;right:-10rpx;top:-12rpx;min-width:23rpx;padding:1rpx 7rpx;border-radius:25rpx;background:#ad5038;color:#fff;font-size:20rpx;text-align:center;line-height:1.5;box-sizing:border-box}
.recharge-hint{display:flex;align-items:center;gap:14rpx;padding:18rpx 22rpx;margin-top:20rpx;background:#efebe3;border-radius:14rpx;color:#69776f;font-size:25rpx;line-height:1.5}.recharge-hint image{width:32rpx;height:32rpx;flex:none}
.subscription-prompt{display:flex;align-items:center;flex-wrap:wrap;gap:20rpx;padding:24rpx;margin-top:24rpx;border:1rpx solid #e9dac0;border-radius:18rpx;background:#faf4e8}.subscription-copy{flex:1;min-width:210rpx}.subscription-title{display:block;font-size:27rpx;font-weight:600;color:#554b38}.subscription-hint{display:block;margin-top:6rpx;color:#766950;font-size:23rpx;line-height:1.5}.subscription-actions{display:flex;align-items:center;gap:12rpx;margin-left:auto}.subscription-actions button{min-height:44px;padding:14rpx 20rpx;font-size:24rpx;line-height:1.5;border-radius:30rpx}.subscription-later{background:transparent;color:#766950}.subscription-enable{background:#193432;color:#fff}
.profile-skeleton{padding:44rpx 30rpx;border-radius:26rpx;background:#dde5dc}.profile-skeleton view{height:44rpx;margin-bottom:32rpx;border-radius:12rpx;background:#cbd8ca}.profile-skeleton view:first-child{width:45%}.profile-skeleton view:last-child{height:76rpx;margin-bottom:0}.member-state{display:flex;align-items:center;flex-direction:column;padding:80rpx 20rpx;text-align:center}.member-state image{width:80rpx;height:80rpx;margin-bottom:24rpx}.state-title{font-size:30rpx;font-weight:600}.state-copy{margin-top:14rpx;font-size:26rpx;color:#69776f;line-height:1.6}.member-state button{margin-top:28rpx;padding:18rpx 34rpx;color:#fff;background:#193432;font-size:28rpx}.refresh-error{display:flex;align-items:center;gap:20rpx;padding:20rpx 0;color:#a44d36;font-size:24rpx}.refresh-error text{flex:1}.refresh-error button{padding:12rpx 20rpx;color:#193432;background:#e9eee6;font-size:24rpx}
@media(max-width:350px){.profile-top{flex-wrap:wrap}.profile-settings{margin-left:auto;padding-top:8rpx}.member-name{font-size:18px}.member-expiry,.member-level,.service-description{font-size:12px}.primary-service{flex-direction:column;align-items:flex-start;position:relative}.primary-service .service-chevron{position:absolute;right:20rpx;top:24rpx}.service-title{font-size:13px}.service-entry{gap:12rpx;padding:22rpx 18rpx}.service-icon image{width:48rpx;height:48rpx}.metric-label{font-size:12px}.metric-value{font-size:17px}.metric-long{font-size:13px}.recharge-hint{font-size:13px}}

.member-level text{color:#debd8c}.tier-color{width:10rpx;height:10rpx;border-radius:50%;flex:none}
