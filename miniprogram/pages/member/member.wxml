<view class="page"><view class="profile"><view class="profile-top"><view class="identity"><image wx:if="{{avatar}}" class="avatar" src="{{avatar}}" mode="aspectFill"/><view wx:else class="avatar fallback">{{initial}}</view><view><text class="name">{{user.nickname || '顾客'}}</text><view class="badge-row" bindtap="openTierRules"><text class="badge" style="background: {{user.memberColor || '#C77F52'}}">{{user.memberLevel || '普通会员'}}</text><text class="badge-arrow">查看等级权益 ›</text></view><text wx:if="{{expiry}}" class="expiry">有效期至 {{expiry}}</text></view></view><button class="profile-settings" bindtap="openProfile">资料设置</button></view><view class="balances"><view><text>储值余额</text><text class="balance-value">¥{{wallet.stored || '0.00'}}</text></view><view><text>赠金</text><text class="balance-value">¥{{wallet.bonus || '0.00'}}</text></view><view><text>积分</text><text class="balance-value">{{user.points || 0}}</text></view></view></view><view wx:if="{{subscriptionPromptVisible}}" class="subscription-prompt"><view class="subscription-copy"><text class="subscription-title">开启消息提醒</text><text class="subscription-hint">订单、优惠券和活动消息会及时通知你</text></view><button class="subscription-later" bindtap="postponeSubscription">暂不</button><button class="subscription-enable" bindtap="enableSubscription" loading="{{subscriptionPromptBusy}}">开启提醒</button></view><view class="entry-grid"><view wx:for="{{entries}}" wx:key="key" class="entry" data-key="{{item.key}}" bindtap="open"><view class="entry-icon icon-{{item.icon}}">{{item.symbol}}<text wx:if="{{item.badgeCount}}" class="entry-count">{{item.badgeCount > 99 ? '99+' : item.badgeCount}}</text></view><text>{{item.title}}</text></view></view></view>
