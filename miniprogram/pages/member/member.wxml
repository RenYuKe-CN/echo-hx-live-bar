<view class="page"><view class="profile"><view class="identity"><image wx:if="{{avatar}}" class="avatar" src="{{avatar}}" mode="aspectFill"/><view wx:else class="avatar fallback">{{initial}}</view><view><text class="name">{{user.nickname || '顾客'}}</text><text class="badge">{{user.member_level || '普通会员'}}</text><text wx:if="{{expiry}}" class="expiry">有效期至 {{expiry}}</text></view></view><view class="balances"><view><text>储值余额</text><text class="balance-value">¥{{wallet.stored || '0.00'}}</text></view><view><text>赠金</text><text class="balance-value">¥{{wallet.bonus || '0.00'}}</text></view><view><text>积分</text><text class="balance-value">{{user.points || 0}}</text></view></view></view><view class="entry-grid"><view wx:for="{{entries}}" wx:key="key" class="entry" data-key="{{item.key}}" bindtap="open"><view class="entry-icon icon-{{item.icon}}">{{item.symbol}}</view><text>{{item.title}}</text></view></view></view>
